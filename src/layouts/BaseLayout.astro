---
import '@fontsource-variable/nunito';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '../styles/global.css';
import { business as businessDetails, phoneHref, serviceAreas, readContent } from '../lib/cms';
import home from '../content/home.json';

interface Props { title?: string; description?: string; }
const {
  title = readContent(home.seo.title),
  description = readContent(home.seo.description),
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const business = {
  '@context': 'https://schema.org',
  '@type': 'LandscapingBusiness',
  name: businessDetails.name,
  url: Astro.site?.toString(),
  telephone: phoneHref.replace('tel:', ''),
  email: businessDetails.email,
  areaServed: serviceAreas,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c81022" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

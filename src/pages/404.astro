---
import rawContent from '../content/not-found.json';
import { readContent, safeLink } from '../lib/cms';
const content = readContent(rawContent);
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title={content.seo.title}>
  <main id="main" class="container" style="padding-block: 20vh; max-width: 700px;">
    <p class="eyebrow">{content.general.paragraph}</p>
    <h1 style="font-size: 3rem; margin-bottom: 20px;">{content.general.heading}<br />{content.general.heading2}</h1>
    <p style="margin-bottom: 30px;">{content.general.paragraph2}</p>
    <a class="button button-red" href={safeLink(content.general.link)}>{content.general.linkLabel}</a>
  </main>
</BaseLayout>

---
import { ArrowDown, ArrowRight, ArrowUpRight, BadgeCheck, Building, ChevronRight, House, Leaf, MapPin, MessageCircle, Sprout, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ClientPhoto from '../components/ClientPhoto.astro';
import { clientPhotos } from '../data/client-photos';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import '../styles/about.css';

const values = [
  { icon: Users, title: 'A personal touch.', copy: 'Every property belongs to someone. We start by listening to what you have in mind and the way you want to enjoy your outdoor space.' },
  { icon: Leaf, title: 'Pride in the details.', copy: 'A neat edge. A thoughtfully placed plant. A freshly cared-for bed. We believe the little things help bring the whole yard together.' },
  { icon: Sprout, title: 'Experience, put to work.', copy: 'More than 20 years of hands-on landscaping experience guide the care we bring to the homes and businesses around our community.' },
];
const communities = ['South Bend', 'Mishawaka', 'Granger', 'Osceola'];
---
<BaseLayout title="About Our Family-Owned Team | Flores Landscaping, South Bend" description="Get to know Flores Landscaping, a family-owned and operated business with over 20 years of experience serving South Bend and nearby communities. Licensed and insured. Free estimates.">
  <div id="top"></div>
  <Header />
  <main id="main" class="about-page">
    <section class="company-intro" aria-labelledby="company-title">
      <div class="container">
        <nav class="company-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><ChevronRight size={13} aria-hidden="true" /><span aria-current="page">About us</span></nav>
        <div class="company-intro-grid">
          <div class="company-intro-copy" data-reveal-group>
            <div class="eyebrow"><Leaf size={19} aria-hidden="true" /> ABOUT FLORES LANDSCAPING</div>
            <h1 id="company-title">Local roots.<br /><em>Lasting care.</em></h1>
            <p>Behind every well-cared-for yard are people who take pride in it. We’re Flores Landscaping—a family-owned team helping outdoor spaces around South Bend feel a little more like home.</p>
            <div class="company-intro-actions"><a class="button button-red" href="#our-story">GET TO KNOW US <ArrowDown size={17} aria-hidden="true" /></a><a class="text-link" href="/services/">EXPLORE OUR SERVICES <ArrowUpRight size={18} aria-hidden="true" /></a></div>
          </div>
          <div class="company-intro-visual reveal" style="--reveal-delay: 170ms">
            <ImagePlaceholder label="A photo of the Flores family or team here" tone="dark" />
            <div class="company-photo-caption"><Users size={24} stroke-width={1.4} aria-hidden="true" /><span>Family owned.<br /><strong>Community minded.</strong></span><span>THE PEOPLE BEHIND THE CARE</span></div>
          </div>
        </div>
        <div class="company-at-a-glance" data-reveal-group>
          <div><strong class="company-years">20<span>+</span></strong><span>YEARS OF<br /><b>HANDS-ON EXPERIENCE</b></span></div>
          <div><BadgeCheck size={32} stroke-width={1.3} aria-hidden="true" /><span>LICENSED<br /><b>& INSURED</b></span></div>
          <div><House size={32} stroke-width={1.3} aria-hidden="true" /><span>HERE FOR HOMES<br /><b>& BUSINESSES</b></span></div>
        </div>
      </div>
    </section>

    <section id="our-story" class="company-story section-pad" aria-labelledby="company-story-title">
      <div class="container company-story-grid">
        <div class="company-story-visual reveal">
          <ClientPhoto {...clientPhotos.p8289} />
          <div class="company-story-caption"><Leaf size={19} aria-hidden="true" /><span>Good people. Thoughtful work. A little pride in every detail.</span></div>
        </div>
        <div class="company-story-copy reveal" style="--reveal-delay: 100ms">
          <div class="eyebrow"><Sprout size={19} aria-hidden="true" /> ROOTED IN OUR COMMUNITY</div>
          <h2 id="company-story-title">People who care.<br /><em>Work that shows.</em></h2>
          <p class="company-lead">Good landscaping starts with a personal connection.</p>
          <p>Flores Landscaping is a family-owned and operated business with more than 20 years of experience serving South Bend and the surrounding communities. Caring for local outdoor spaces is what we do, from everyday lawn care to landscape design and seasonal cleanups.</p>
          <p>We know a yard is more than the space around a building. It’s the welcome at your front door, the view from your window, and a place to spend time outside. We bring that same personal attention to the properties we care for.</p>
          <div class="company-story-note"><span aria-hidden="true"></span><p>Your property deserves the care<br />we’d give our own.</p></div>
          <a class="text-link" href="/contact/#estimate">LET’S TALK ABOUT YOUR SPACE <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <section class="company-values" aria-labelledby="company-values-title">
      <div class="container">
        <div class="company-values-heading reveal"><div><div class="eyebrow">THE FLORES APPROACH</div><h2 id="company-values-title">Care is personal.<br /><em>So is our approach.</em></h2></div><p>From the first conversation to the finishing touches, these are the things that matter to us.</p></div>
        <div class="company-values-grid" data-reveal-group>{values.map(({ icon: Icon, title, copy }, index) => <article><div class="company-value-top"><Icon size={35} stroke-width={1.25} aria-hidden="true" /><span aria-hidden="true">0{index + 1}</span></div><h3>{title}</h3><p>{copy}</p></article>)}</div>
      </div>
    </section>

    <section class="company-community section-pad" aria-labelledby="company-community-title">
      <div class="container company-community-grid">
        <div class="company-community-copy reveal"><div class="eyebrow"><MapPin size={18} aria-hidden="true" /> YOUR LOCAL LANDSCAPING TEAM</div><h2 id="company-community-title">Rooted here.<br /><em>Ready for your yard.</em></h2><p>We serve residential and commercial properties in South Bend and nearby communities. Wherever you are in our service area, we’d love to hear what you have in mind for your space.</p><div class="company-property-types"><span><House size={18} aria-hidden="true" /> RESIDENTIAL</span><span><Building size={18} aria-hidden="true" /> COMMERCIAL</span></div><a class="text-link" href="/services/">FIND THE RIGHT CARE <ArrowRight size={18} aria-hidden="true" /></a></div>
        <div class="company-community-list reveal" style="--reveal-delay: 100ms"><span class="company-community-label">PROUDLY SERVING</span><ul>{communities.map(community => <li><MapPin size={22} stroke-width={1.3} aria-hidden="true" /><span>{community}</span><span>INDIANA</span></li>)}</ul><p>Nearby, but don’t see your community?<br /><a href="tel:+15743866078">Give us a call to check your area. <ArrowUpRight size={16} aria-hidden="true" /></a></p></div>
      </div>
    </section>

    <section id="estimate" class="company-estimate" aria-labelledby="company-estimate-title">
      <div class="container company-estimate-grid">
        <div class="reveal"><div class="eyebrow"><MessageCircle size={18} aria-hidden="true" /> A GOOD PLACE TO START</div><h2 id="company-estimate-title">Let’s get to know<br /><em>your outdoor space.</em></h2><p>Tell us a little about your property and the care you’re looking for. We’ll start with a conversation and a free estimate.</p></div>
        <div class="company-estimate-contact reveal" style="--reveal-delay: 100ms"><span>CALL OR TEXT THE FLORES TEAM</span><a class="company-phone" href="tel:+15743866078">(574) 386-6078 <ArrowUpRight size={26} aria-hidden="true" /></a><a class="button button-red" href="/contact/#estimate">REQUEST A FREE ESTIMATE <MessageCircle size={18} aria-hidden="true" /></a><a class="company-email" href="mailto:floreslandscaping098@gmail.com">Prefer email? We’d love to hear from you. <ArrowRight size={16} aria-hidden="true" /></a></div>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import { initReveals } from '../scripts/scroll-reveals';
    initReveals();
  </script>
</BaseLayout>

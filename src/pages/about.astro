---
import rawContent from '../content/about.json';
import { readContent, resolvePhoto, safeLink, business, phoneHref, emailHref, serviceAreas } from '../lib/cms';
const content = readContent(rawContent);
import { ArrowDown, ArrowRight, ArrowUpRight, BadgeCheck, Building, ChevronRight, House, Leaf, MapPin, MessageCircle, Sprout, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ClientPhoto from '../components/ClientPhoto.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import '../styles/about.css';

const values = Object.values(content.values).map((item, index) => ({ ...item, icon: [Users,Leaf,Sprout][index], number: String(index + 1).padStart(2, '0') }));
const communities = serviceAreas;
---
<BaseLayout title={content.seo.title} description={content.seo.description}>
  <div id="top"></div>
  <Header />
  <main id="main" class="about-page">
    <section class="company-intro" aria-labelledby="company-title">
      <div class="container">
        <nav class="company-breadcrumb" aria-label="Breadcrumb"><a href={safeLink(content.companyIntro.link)}>{content.companyIntro.linkLabel}</a><ChevronRight size={13} aria-hidden="true" /><span aria-current="page">{content.companyIntro.text}</span></nav>
        <div class="company-intro-grid">
          <div class="company-intro-copy" data-reveal-group>
            <div class="eyebrow"><Leaf size={19} aria-hidden="true" /> {content.companyIntro.eyebrow}</div>
            <h1 id="company-title">{content.companyIntro.heading}<br /><em>{content.companyIntro.text2}</em></h1>
            <p>{content.companyIntro.paragraph}</p>
            <div class="company-intro-actions"><a class="button button-red" href={safeLink(content.companyIntro.link2)}>{content.companyIntro.linkLabel2} <ArrowDown size={17} aria-hidden="true" /></a><a class="text-link" href={safeLink(content.companyIntro.link3)}>{content.companyIntro.linkLabel3} <ArrowUpRight size={18} aria-hidden="true" /></a></div>
          </div>
          <div class="company-intro-visual reveal" style="--reveal-delay: 170ms">
            <ImagePlaceholder label="A photo of the Flores family or team here" tone="dark" />
            <div class="company-photo-caption"><Users size={24} stroke-width={1.4} aria-hidden="true" /><span>{content.companyIntro.text3}<br /><strong>{content.companyIntro.text4}</strong></span><span>{content.companyIntro.text5}</span></div>
          </div>
        </div>
        <div class="company-at-a-glance" data-reveal-group>
          <div><strong class="company-years">{business.experienceYears}<span>+</span></strong><span>{content.companyIntro.text6}<br /><b>{content.companyIntro.text7}</b></span></div>
          <div><BadgeCheck size={32} stroke-width={1.3} aria-hidden="true" /><span>{content.companyIntro.text8}<br /><b>{content.companyIntro.text9}</b></span></div>
          <div><House size={32} stroke-width={1.3} aria-hidden="true" /><span>{content.companyIntro.text10}<br /><b>{content.companyIntro.text11}</b></span></div>
        </div>
      </div>
    </section>

    <section id="our-story" class="company-story section-pad" aria-labelledby="company-story-title">
      <div class="container company-story-grid">
        <div class="company-story-visual reveal">
          <ClientPhoto {...resolvePhoto(content.ourStory.photo)} />
          <div class="company-story-caption"><Leaf size={19} aria-hidden="true" /><span>{content.ourStory.text}</span></div>
        </div>
        <div class="company-story-copy reveal" style="--reveal-delay: 100ms">
          <div class="eyebrow"><Sprout size={19} aria-hidden="true" /> {content.ourStory.eyebrow}</div>
          <h2 id="company-story-title">{content.ourStory.heading}<br /><em>{content.ourStory.text2}</em></h2>
          <p class="company-lead">{content.ourStory.paragraph}</p>
          <p>{content.ourStory.paragraph2}</p>
          <p>{content.ourStory.paragraph3}</p>
          <div class="company-story-note"><span aria-hidden="true"></span><p>{content.ourStory.paragraph4}<br />{content.ourStory.paragraph5}</p></div>
          <a class="text-link" href={safeLink(content.ourStory.link)}>{content.ourStory.linkLabel} <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <section class="company-values" aria-labelledby="company-values-title">
      <div class="container">
        <div class="company-values-heading reveal"><div><div class="eyebrow">{content.companyValues.eyebrow}</div><h2 id="company-values-title">{content.companyValues.heading}<br /><em>{content.companyValues.text}</em></h2></div><p>{content.companyValues.paragraph}</p></div>
        <div class="company-values-grid" data-reveal-group>{values.map(({ icon: Icon, title, copy }, index) => <article><div class="company-value-top"><Icon size={35} stroke-width={1.25} aria-hidden="true" /><span aria-hidden="true">0{index + 1}</span></div><h3>{title}</h3><p>{copy}</p></article>)}</div>
      </div>
    </section>

    <section class="company-community section-pad" aria-labelledby="company-community-title">
      <div class="container company-community-grid">
        <div class="company-community-copy reveal"><div class="eyebrow"><MapPin size={18} aria-hidden="true" /> {content.companyCommunity.eyebrow}</div><h2 id="company-community-title">{content.companyCommunity.heading}<br /><em>{content.companyCommunity.text}</em></h2><p>{content.companyCommunity.paragraph}</p><div class="company-property-types"><span><House size={18} aria-hidden="true" /> {content.companyCommunity.text2}</span><span><Building size={18} aria-hidden="true" /> {content.companyCommunity.text3}</span></div><a class="text-link" href={safeLink(content.companyCommunity.link)}>{content.companyCommunity.linkLabel} <ArrowRight size={18} aria-hidden="true" /></a></div>
        <div class="company-community-list reveal" style="--reveal-delay: 100ms"><span class="company-community-label">{content.companyCommunity.text4}</span><ul>{communities.map(community => <li><MapPin size={22} stroke-width={1.3} aria-hidden="true" /><span>{community}</span><span>{content.companyCommunity.text5}</span></li>)}</ul><p>{content.companyCommunity.paragraph2}<br /><a href={phoneHref}>{content.companyCommunity.linkLabel2} <ArrowUpRight size={16} aria-hidden="true" /></a></p></div>
      </div>
    </section>

    <section id="estimate" class="company-estimate" aria-labelledby="company-estimate-title">
      <div class="container company-estimate-grid">
        <div class="reveal"><div class="eyebrow"><MessageCircle size={18} aria-hidden="true" /> {content.estimate.eyebrow}</div><h2 id="company-estimate-title">{content.estimate.heading}<br /><em>{content.estimate.text}</em></h2><p>{content.estimate.paragraph}</p></div>
        <div class="company-estimate-contact reveal" style="--reveal-delay: 100ms"><span>{content.estimate.text2}</span><a class="company-phone" href={phoneHref}>{business.primaryPhone} <ArrowUpRight size={26} aria-hidden="true" /></a><a class="button button-red" href={safeLink(content.estimate.link)}>{content.estimate.linkLabel} <MessageCircle size={18} aria-hidden="true" /></a><a class="company-email" href={emailHref}>{content.estimate.linkLabel2} <ArrowRight size={16} aria-hidden="true" /></a></div>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import { initReveals } from '../scripts/scroll-reveals';
    initReveals();
  </script>
</BaseLayout>

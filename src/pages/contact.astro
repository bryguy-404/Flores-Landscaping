---
import rawContent from '../content/contact.json';
import { readContent, resolvePhoto, safeLink, business, phoneHref, secondaryPhoneHref, smsHref, emailHref, serviceAreas } from '../lib/cms';
const content = readContent(rawContent);
import { ArrowDown, ArrowRight, ArrowUpRight, BadgeCheck, Check, ChevronRight, Leaf, Mail, MapPin, MessageCircle, Phone, Plus, Send } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ClientPhoto from '../components/ClientPhoto.astro';
import { contactServices, propertyTypes } from '../data/contact';
import { serviceOfferings } from '../data/services';
const serviceLabel = (id: string) => serviceOfferings.find(service => service.id === id)?.title ?? content.formChoices.notSureService;
const propertyLabels = [content.formChoices.residential, content.formChoices.commercial, content.formChoices.notSureProperty];
import '../styles/contact.css';

const questions = Object.values(content.questions);
---
<BaseLayout title={content.seo.title} description={content.seo.description}>
  <div id="top"></div>
  <Header />
  <main id="main" class="inquiry-page">
    <section class="inquiry-intro" aria-labelledby="inquiry-title">
      <div class="container">
        <nav class="inquiry-breadcrumb" aria-label="Breadcrumb"><a href={safeLink(content.inquiryIntro.link)}>{content.inquiryIntro.linkLabel}</a><ChevronRight size={13} aria-hidden="true" /><span aria-current="page">{content.inquiryIntro.text}</span></nav>
        <div class="inquiry-intro-grid">
          <div data-reveal-group><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> {content.inquiryIntro.eyebrow}</div><h1 id="inquiry-title">{content.inquiryIntro.heading}<br /><em>{content.inquiryIntro.text2}</em></h1></div>
          <div class="inquiry-intro-note reveal"><p>{content.inquiryIntro.paragraph}</p><a class="text-link" href={safeLink(content.inquiryIntro.link2)}>{content.inquiryIntro.linkLabel2} <ArrowDown size={18} aria-hidden="true" /></a></div>
        </div>
        <div class="inquiry-trust"><span><Check size={18} aria-hidden="true" /> {content.inquiryIntro.text3}</span><span><BadgeCheck size={18} aria-hidden="true" /> {content.inquiryIntro.text4}</span><span><MapPin size={18} aria-hidden="true" /> {content.inquiryIntro.text5}</span></div>
      </div>
    </section>

    <section class="inquiry-main section-pad" aria-labelledby="estimate-title">
      <div class="container inquiry-layout">
        <aside class="inquiry-details reveal" aria-labelledby="inquiry-details-title">
          <div class="eyebrow"><MessageCircle size={18} aria-hidden="true" /> {content.inquiryMain.eyebrow}</div><h2 id="inquiry-details-title">{content.inquiryMain.heading}<br /><em>{content.inquiryMain.text}</em></h2><p>{content.inquiryMain.paragraph}</p>
          <div class="inquiry-direct-links">
            <div><span class="inquiry-link-icon"><Phone size={22} stroke-width={1.4} aria-hidden="true" /></span><div><span class="inquiry-link-label">{content.inquiryMain.text2}</span><a class="inquiry-primary-phone" href={phoneHref}>{business.primaryPhone} <ArrowUpRight size={19} aria-hidden="true" /></a><a class="inquiry-secondary-phone" href={secondaryPhoneHref}>{content.inquiryMain.linkLabel}</a></div></div>
            <div><span class="inquiry-link-icon"><MessageCircle size={22} stroke-width={1.4} aria-hidden="true" /></span><div><span class="inquiry-link-label">{content.inquiryMain.text3}</span><a href={smsHref}>{content.inquiryMain.linkLabel2} <ArrowUpRight size={17} aria-hidden="true" /></a></div></div>
            <div><span class="inquiry-link-icon"><Mail size={22} stroke-width={1.4} aria-hidden="true" /></span><div><span class="inquiry-link-label">{content.inquiryMain.text4}</span><a class="inquiry-email" href={emailHref}>{business.email}<ArrowUpRight size={17} aria-hidden="true" /></a></div></div>
          </div>
          <div class="inquiry-next"><span class="inquiry-small-label">{content.inquiryMain.text5}</span><ol><li><span>01</span><div><h3>{content.inquiryMain.heading2}</h3><p>{content.inquiryMain.paragraph2}</p></div></li><li><span>02</span><div><h3>{content.inquiryMain.heading3}</h3><p>{content.inquiryMain.paragraph3}</p></div></li></ol></div>
        </aside>

        <div id="estimate" class="inquiry-form-card reveal" style="--reveal-delay: 100ms">
          <span class="inquiry-small-label">{content.inquiryMain.text6}</span><h2 id="estimate-title">{content.inquiryMain.heading4}</h2><p class="inquiry-form-intro">{content.inquiryMain.paragraph4}<br />{content.inquiryMain.paragraph5} <span aria-hidden="true">*</span><span class="sr-only">{content.inquiryMain.text7}</span> {content.inquiryMain.paragraph6}</p>
          <form id="estimate-form" action="/api/contact" method="post" aria-labelledby="estimate-title">
            <div class="inquiry-fields">
              <div class="inquiry-field"><label for="full-name">{content.inquiryMain.text8} <span aria-hidden="true">*</span></label><input id="full-name" name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder={content.inquiryMain.placeholder} /></div>
              <div class="inquiry-field"><label for="email">{content.inquiryMain.text9} <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder={content.inquiryMain.placeholder2} /></div>
              <div class="inquiry-field"><label for="phone">{content.inquiryMain.text10} <span class="inquiry-optional">{content.inquiryMain.text11}</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" placeholder={content.inquiryMain.placeholder3} /></div>
              <div class="inquiry-field"><label for="city">{content.inquiryMain.text12} <span aria-hidden="true">*</span></label><input id="city" name="city" autocomplete="address-level2" required minlength="2" maxlength="100" placeholder={content.inquiryMain.placeholder4} /></div>
              <div class="inquiry-field"><label for="service">{content.inquiryMain.text13} <span aria-hidden="true">*</span></label><select id="service" name="service" required><option value="" disabled selected>{content.inquiryMain.text14}</option>{contactServices.map(service => <option value={service.id}>{serviceLabel(service.id)}</option>)}</select></div>
              <div class="inquiry-field"><label for="property-type">{content.inquiryMain.text15} <span aria-hidden="true">*</span></label><select id="property-type" name="propertyType" required><option value="" disabled selected>{content.inquiryMain.text16}</option>{propertyTypes.map((type, index) => <option value={type}>{propertyLabels[index]}</option>)}</select></div>
              <div class="inquiry-field inquiry-field-wide"><label for="message">{content.inquiryMain.text17} <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="5" required minlength="10" maxlength="3000" aria-describedby="message-hint" placeholder={content.inquiryMain.placeholder5}></textarea><small id="message-hint">{content.inquiryMain.text18}</small></div>
            </div>
            <div class="inquiry-honeypot" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
            <div id="estimate-verification"></div>
            <p class="inquiry-form-status" id="estimate-status" role="status" aria-live="polite" aria-atomic="true">Online requests are coming soon. For now, please call, text, or email our team.</p>
            <button class="button button-red inquiry-submit" id="estimate-submit" type="submit" disabled><span>{content.inquiryMain.text19}</span><Send size={17} aria-hidden="true" /></button>
            <p class="inquiry-form-note">{content.inquiryMain.paragraph7}</p>
            <noscript><p class="inquiry-noscript">Please enable JavaScript to use the form, or <a href={phoneHref}>call {business.primaryPhone}</a>.</p></noscript>
          </form>
        </div>
      </div>
    </section>

    <section class="inquiry-area" aria-labelledby="inquiry-area-title">
      <div class="container inquiry-area-grid">
        <div class="inquiry-area-photo reveal"><ClientPhoto {...resolvePhoto(content.inquiryArea.photo)}   /><p><Leaf size={18} aria-hidden="true" /> {content.inquiryArea.paragraph}</p></div>
        <div class="inquiry-area-copy reveal" style="--reveal-delay: 100ms"><div class="eyebrow"><MapPin size={18} aria-hidden="true" /> {content.inquiryArea.eyebrow}</div><h2 id="inquiry-area-title">{content.inquiryArea.heading}<br /><em>{content.inquiryArea.text}</em></h2><p>{content.inquiryArea.paragraph2}</p><ul>{serviceAreas.map(city => <li><MapPin size={17} aria-hidden="true" />{city}</li>)}</ul><p class="inquiry-area-note">{content.inquiryArea.paragraph3}<br /><a href={phoneHref}>{content.inquiryArea.linkLabel} <ArrowUpRight size={16} aria-hidden="true" /></a></p></div>
      </div>
    </section>

    <section class="inquiry-faq section-pad" aria-labelledby="inquiry-faq-title">
      <div class="container inquiry-faq-grid"><div class="reveal"><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> {content.inquiryFaq.eyebrow}</div><h2 id="inquiry-faq-title">{content.inquiryFaq.heading}<br /><em>{content.inquiryFaq.text}</em></h2><a class="text-link" href={safeLink(content.inquiryFaq.link)}>{content.inquiryFaq.linkLabel} <ArrowRight size={17} aria-hidden="true" /></a></div><div class="inquiry-questions reveal">{questions.map(item => <details name="contact-faq"><summary>{item.question}<Plus size={19} aria-hidden="true" /></summary><p>{item.answer}</p></details>)}</div></div>
    </section>
  </main>
  <Footer />
  <script>
    import '../scripts/contact-form';
    import { initReveals } from '../scripts/scroll-reveals';
    initReveals();
  </script>
</BaseLayout>

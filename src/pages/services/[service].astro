---
import { ArrowRight, ArrowUpRight, BadgeCheck, Check, ChevronRight, Leaf, MapPin, MessageCircle, Phone, Plus, Users } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { serviceOfferings } from '../../data/services';
import { servicePages, type ServicePageContent } from '../../data/service-pages';
import '../../styles/service-page.css';

export function getStaticPaths() {
  return serviceOfferings.map((service, index) => ({
    params: { service: service.id },
    props: { service, detail: servicePages[service.id], index },
  }));
}
interface Props {
  service: (typeof serviceOfferings)[number];
  detail: ServicePageContent;
  index: number;
}
const { service, detail, index } = Astro.props;
const Icon = service.icon;
const related = detail.related.map(id => serviceOfferings.find(item => item.id === id)!);
---
<BaseLayout title={`${service.title} in South Bend, IN | Flores Landscaping`} description={`${service.title} from family-owned Flores Landscaping. Serving South Bend, Mishawaka, Granger, and Osceola. ${service.summary} Contact us for a free estimate.`}>
  <div id="top"></div>
  <Header />
  <main id="main" class="service-page">
    <section class="offering-hero" aria-labelledby="offering-title">
      <div class="container">
        <nav class="offering-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><ChevronRight size={12} aria-hidden="true" /><a href="/services/">Our services</a><ChevronRight size={12} aria-hidden="true" /><span aria-current="page">{service.title}</span></nav>
        <div class="offering-hero-grid">
          <div class="offering-hero-copy" data-reveal-group>
            <div class="eyebrow"><Icon size={23} stroke-width={1.4} aria-hidden="true" /> {service.title}</div>
            <h1 id="offering-title">{detail.headline}<br /><em>{detail.accent}</em></h1>
            <p>{detail.introduction}</p>
            <div class="offering-hero-actions"><a class="button button-red" href={`/contact/?service=${service.id}#estimate`}>GET A FREE ESTIMATE <ArrowUpRight size={18} aria-hidden="true" /></a><a class="text-link" href="#service-details">TAKE A CLOSER LOOK <ArrowRight size={18} aria-hidden="true" /></a></div>
          </div>
          <div class="offering-hero-visual reveal" style="--reveal-delay: 170ms">
            <ImagePlaceholder label={service.photo} tone="dark" number={`0${index + 1} / 07`} />
            <div class="offering-photo-note"><span><Icon size={20} stroke-width={1.4} aria-hidden="true" />{service.caption}</span><span>FLORES LANDSCAPING</span></div>
          </div>
        </div>
        <div class="offering-trust" data-reveal-group><span><Users size={18} aria-hidden="true" /> FAMILY OWNED</span><span><BadgeCheck size={18} aria-hidden="true" /> LICENSED & INSURED</span><span><Check size={18} aria-hidden="true" /> FREE ESTIMATES</span></div>
      </div>
    </section>

    <div class="container offering-content-grid section-pad">
      <aside class="offering-sidebar" aria-label="More landscaping services">
        <span class="eyebrow">CARE FOR EVERY CORNER</span>
        <nav aria-label="Services"><h2>Our services</h2><ul>{serviceOfferings.map(item => <li><a href={`/services/${item.id}/`} aria-current={item.id === service.id ? 'page' : undefined}>{item.title}<ChevronRight size={16} aria-hidden="true" /></a></li>)}</ul></nav>
        <div class="offering-sidebar-help"><Leaf size={27} stroke-width={1.4} aria-hidden="true" /><h3>A little advice.<br />A good place to start.</h3><p>Tell us about your property. We’re happy to talk it through.</p><a href="tel:+15743866078"><Phone size={16} aria-hidden="true" />(574) 386-6078</a></div>
        <a class="text-link" href="/services/">ALL SERVICES <ArrowRight size={17} aria-hidden="true" /></a>
      </aside>

      <div class="offering-content">
        <section id="service-details" class="offering-details" aria-labelledby="offering-details-title">
          <div class="reveal"><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> THE DIFFERENCE IS IN THE CARE</div><h2 id="offering-details-title">{detail.sectionTitle}<br /><em>{detail.sectionAccent}</em></h2><p class="offering-lead">{detail.sectionCopy}</p></div>
          <div class="offering-focus" data-reveal-group>{detail.focus.map((item, i) => <article><span class="offering-focus-number">0{i + 1}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div><Check size={18} aria-hidden="true" /></article>)}</div>
        </section>

        <section class="offering-project reveal" aria-labelledby="offering-planning-title">
          <ImagePlaceholder label={detail.detailPhoto} description={detail.detailPhotoNote} number="A CLOSER LOOK" />
          <div class="offering-project-caption"><div class="eyebrow">LET’S START WITH YOUR SPACE</div><h2 id="offering-planning-title">{detail.planningTitle}</h2><p>{detail.planningCopy}</p></div>
        </section>

        <section class="offering-faq reveal" aria-labelledby="offering-faq-title">
          <div class="eyebrow"><MessageCircle size={18} aria-hidden="true" /> GOOD TO KNOW</div><h2 id="offering-faq-title">Before we<br /><em>get started.</em></h2>
          <div class="faq-list">{detail.faqs.map((faq, i) => <details name="service-faq" open={i === 0}><summary>{faq.question}<Plus size={21} aria-hidden="true" /></summary><p>{faq.answer}</p></details>)}</div>
        </section>
      </div>
    </div>

    <section class="offering-related" aria-labelledby="offering-related-title">
      <div class="container"><div class="offering-related-heading reveal"><div><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> A LITTLE MORE CARE</div><h2 id="offering-related-title">Good things<br /><em>grow together.</em></h2></div><a class="text-link" href="/services/">EXPLORE ALL SERVICES <ArrowRight size={18} aria-hidden="true" /></a></div>
        <div class="offering-related-grid" data-reveal-group>{related.map(({ icon: RelatedIcon, ...item }) => <a href={`/services/${item.id}/`} class="offering-related-card"><span class="offering-related-icon"><RelatedIcon size={33} stroke-width={1.2} aria-hidden="true" /></span><div><h3>{item.title}</h3><p>{item.summary}</p></div><ArrowUpRight class="offering-related-arrow" size={24} aria-hidden="true" /></a>)}</div>
      </div>
    </section>

    <section id="estimate" class="offering-estimate" aria-labelledby="offering-estimate-title">
      <div class="container offering-estimate-grid"><div class="reveal"><div class="eyebrow">YOUR LOCAL FLORES TEAM</div><h2 id="offering-estimate-title">{detail.estimateTitle}<br /><em>{detail.estimateAccent}</em></h2><p>Call or text to tell us about your property.<br />Your estimate is free. The conversation is easy.</p><div class="offering-service-area"><MapPin size={17} aria-hidden="true" /><span>South Bend · Mishawaka · Granger · Osceola</span></div></div>
        <div class="offering-estimate-contact reveal" style="--reveal-delay: 100ms"><span>CALL OR TEXT OUR TEAM</span><a class="offering-phone" href="tel:+15743866078">(574) 386-6078 <ArrowUpRight size={26} aria-hidden="true" /></a><a class="button button-red" href={`/contact/?service=${service.id}#estimate`}>REQUEST A FREE ESTIMATE <MessageCircle size={18} aria-hidden="true" /></a><a class="offering-email" href="mailto:floreslandscaping098@gmail.com">Prefer email? Let’s talk. <ArrowRight size={16} aria-hidden="true" /></a></div>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import { initReveals } from '../../scripts/scroll-reveals';
    initReveals();
  </script>
</BaseLayout>

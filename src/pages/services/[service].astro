---
import rawContent from '../../content/service-shared.json';
import { readContent, safeLink, business, phoneHref, emailHref, serviceAreas } from '../../lib/cms';
const content = readContent(rawContent);
import { ArrowRight, ArrowUpRight, BadgeCheck, Check, ChevronRight, Leaf, MapPin, MessageCircle, Phone, Plus, Users } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ClientPhoto from '../../components/ClientPhoto.astro';
import { servicePhotos } from '../../data/client-photos';
import { serviceOfferings } from '../../data/services';
import { servicePages, type ServicePageContent } from '../../data/service-pages';
import '../../styles/service-page.css';

export function getStaticPaths() {
  return serviceOfferings.map((service) => ({
    params: { service: service.id },
    props: { service, detail: servicePages[service.id] },
  }));
}
interface Props {
  service: (typeof serviceOfferings)[number];
  detail: ServicePageContent;
}
const { service, detail } = Astro.props;
const Icon = service.icon;
const photos = servicePhotos[service.id];
const related = detail.related.map(id => serviceOfferings.find(item => item.id === id)!);
---
<BaseLayout title={`${service.title} in ${business.city}, IN | Flores Landscaping`} description={`${service.title} from family-owned Flores Landscaping. Serving ${serviceAreas.join(', ')}. ${service.summary} Contact us for a free estimate.`}>
  <div id="top"></div>
  <Header />
  <main id="main" class="service-page">
    <section class="offering-hero" aria-labelledby="offering-title">
      <div class="container">
        <nav class="offering-breadcrumb" aria-label="Breadcrumb"><a href={safeLink(content.offeringHero.link)}>{content.offeringHero.linkLabel}</a><ChevronRight size={12} aria-hidden="true" /><a href={safeLink(content.offeringHero.link2)}>{content.offeringHero.linkLabel2}</a><ChevronRight size={12} aria-hidden="true" /><span aria-current="page">{service.title}</span></nav>
        <div class:list={["offering-hero-grid", { "offering-hero-grid-text": !photos?.hero }]}>
          <div class="offering-hero-copy" data-reveal-group>
            <div class="eyebrow"><Icon size={23} stroke-width={1.4} aria-hidden="true" /> {service.title}</div>
            <h1 id="offering-title">{detail.headline}<br /><em>{detail.accent}</em></h1>
            <p>{detail.introduction}</p>
            <div class="offering-hero-actions"><a class="button button-red" href={safeLink(service.estimateLink)}>{content.offeringHero.linkLabel3} <ArrowUpRight size={18} aria-hidden="true" /></a><a class="text-link" href={safeLink(content.offeringHero.link3)}>{content.offeringHero.linkLabel4} <ArrowRight size={18} aria-hidden="true" /></a></div>
          </div>
          {photos?.hero && <div class="offering-hero-visual reveal" style="--reveal-delay: 170ms">
            <ClientPhoto {...photos.hero} eager />
            <div class="offering-photo-note"><span><Icon size={20} stroke-width={1.4} aria-hidden="true" />{service.caption}</span><span>{content.offeringHero.text}</span></div>
          </div>}
        </div>
        <div class="offering-trust" data-reveal-group><span><Users size={18} aria-hidden="true" /> {content.offeringHero.text2}</span><span><BadgeCheck size={18} aria-hidden="true" /> {content.offeringHero.text3}</span><span><Check size={18} aria-hidden="true" /> {content.offeringHero.text4}</span></div>
      </div>
    </section>

    <div class="container offering-content-grid section-pad">
      <aside class="offering-sidebar" aria-label="More landscaping services">
        <span class="eyebrow">{content.general.eyebrow}</span>
        <nav aria-label="Services"><h2>{content.general.heading}</h2><ul>{serviceOfferings.map(item => <li><a href={safeLink(item.link)} aria-current={item.id === service.id ? 'page' : undefined}>{item.title}<ChevronRight size={16} aria-hidden="true" /></a></li>)}</ul></nav>
        <div class="offering-sidebar-help"><Leaf size={27} stroke-width={1.4} aria-hidden="true" /><h3>{content.general.heading2}<br />{content.general.heading3}</h3><p>{content.general.paragraph}</p><a href={phoneHref}><Phone size={16} aria-hidden="true" />{business.primaryPhone}</a></div>
        <a class="text-link" href={safeLink(content.general.link)}>{content.general.linkLabel} <ArrowRight size={17} aria-hidden="true" /></a>
      </aside>

      <div class="offering-content">
        <section id="service-details" class="offering-details" aria-labelledby="offering-details-title">
          <div class="reveal"><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> {content.serviceDetails.eyebrow}</div><h2 id="offering-details-title">{detail.sectionTitle}<br /><em>{detail.sectionAccent}</em></h2><p class="offering-lead">{detail.sectionCopy}</p></div>
          <div class="offering-focus" data-reveal-group>{detail.focus.map((item, i) => <article><span class="offering-focus-number">0{i + 1}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div><Check size={18} aria-hidden="true" /></article>)}</div>
        </section>

        <section class="offering-project reveal" aria-labelledby="offering-planning-title">
          {photos?.detail && <ClientPhoto {...photos.detail} />}
          <div class="offering-project-caption"><div class="eyebrow">{content.offeringProject.eyebrow}</div><h2 id="offering-planning-title">{detail.planningTitle}</h2><p>{detail.planningCopy}</p></div>
        </section>

        <section class="offering-faq reveal" aria-labelledby="offering-faq-title">
          <div class="eyebrow"><MessageCircle size={18} aria-hidden="true" /> {content.offeringFaq.eyebrow}</div><h2 id="offering-faq-title">{content.offeringFaq.heading}<br /><em>{content.offeringFaq.text}</em></h2>
          <div class="faq-list">{detail.faqs.map((faq, i) => <details name="service-faq" open={i === 0}><summary>{faq.question}<Plus size={21} aria-hidden="true" /></summary><p>{faq.answer}</p></details>)}</div>
        </section>
      </div>
    </div>

    <section class="offering-related" aria-labelledby="offering-related-title">
      <div class="container"><div class="offering-related-heading reveal"><div><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> {content.offeringRelated.eyebrow}</div><h2 id="offering-related-title">{content.offeringRelated.heading}<br /><em>{content.offeringRelated.text}</em></h2></div><a class="text-link" href={safeLink(content.offeringRelated.link)}>{content.offeringRelated.linkLabel} <ArrowRight size={18} aria-hidden="true" /></a></div>
        <div class="offering-related-grid" data-reveal-group>{related.map(({ icon: RelatedIcon, ...item }) => <a href={safeLink(item.link)} class="offering-related-card"><span class="offering-related-icon"><RelatedIcon size={33} stroke-width={1.2} aria-hidden="true" /></span><div><h3>{item.title}</h3><p>{item.summary}</p></div><ArrowUpRight class="offering-related-arrow" size={24} aria-hidden="true" /></a>)}</div>
      </div>
    </section>

    <section id="estimate" class="offering-estimate" aria-labelledby="offering-estimate-title">
      <div class="container offering-estimate-grid"><div class="reveal"><div class="eyebrow">{content.estimate.eyebrow}</div><h2 id="offering-estimate-title">{detail.estimateTitle}<br /><em>{detail.estimateAccent}</em></h2><p>{content.estimate.paragraph}<br />{content.estimate.paragraph2}</p><div class="offering-service-area"><MapPin size={17} aria-hidden="true" /><span>{content.estimate.text}</span></div></div>
        <div class="offering-estimate-contact reveal" style="--reveal-delay: 100ms"><span>{content.estimate.text2}</span><a class="offering-phone" href={phoneHref}>{business.primaryPhone} <ArrowUpRight size={26} aria-hidden="true" /></a><a class="button button-red" href={safeLink(service.estimateLink)}>{content.estimate.linkLabel} <MessageCircle size={18} aria-hidden="true" /></a><a class="offering-email" href={emailHref}>{content.estimate.linkLabel2} <ArrowRight size={16} aria-hidden="true" /></a></div>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import { initReveals } from '../../scripts/scroll-reveals';
    initReveals();
  </script>
</BaseLayout>

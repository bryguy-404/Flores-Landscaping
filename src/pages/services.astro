---
import { ArrowDown, ArrowRight, ArrowUpRight, BadgeCheck, Building, Check, ChevronRight, House, Leaf, MapPin, MessageCircle, Plus, Sprout, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { serviceOfferings } from '../data/services';
import '../styles/services.css';

const steps = [
  { number: '01', icon: MessageCircle, title: 'Tell us what you have in mind.', description: 'A yard that needs regular care? A landscape ready for a fresh start? Call or text and tell us a little about your space.' },
  { number: '02', icon: House, title: 'Let’s take a closer look.', description: 'We’ll discuss your property, what you’d like to change, and the services that fit. Your estimate is free.' },
  { number: '03', icon: Sprout, title: 'Make room for something beautiful.', description: 'Once you’re happy with the plan, we’ll arrange the work with you and bring care to the details.' },
];
---
<BaseLayout title="Landscaping Services in South Bend, IN | Flores Landscaping" description="Explore lawn care, landscaping, mulch and planting, sod installation, seasonal cleanups, trimming, and snow plowing from Flores Landscaping. Serving South Bend, Mishawaka, Granger, and Osceola. Free estimates.">
  <div id="top"></div>
  <Header />
  <main id="main" class="services-page">
    <section class="services-intro" aria-labelledby="services-title">
      <div class="container">
        <nav class="services-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><ChevronRight size={13} aria-hidden="true" /><span aria-current="page">Our services</span></nav>
        <div class="services-intro-grid">
          <div class="services-intro-copy" data-reveal-group>
            <div class="eyebrow"><Leaf size={18} aria-hidden="true" /> GOOD THINGS START WITH GOOD CARE</div>
            <h1 id="services-title">A little care.<br />A beautiful<br /><em>difference.</em></h1>
            <p>From the lawn you walk across every day to the landscape you’ve been dreaming of. We’re here to help your outdoor space feel like you.</p>
            <div class="services-intro-actions"><a class="button button-red" href="#our-services">FIND YOUR SERVICE <ArrowDown size={17} aria-hidden="true" /></a><a class="text-link" href="#estimate">GET A FREE ESTIMATE <ArrowUpRight size={18} aria-hidden="true" /></a></div>
            <div class="services-intro-note"><Users size={18} aria-hidden="true" /><span>Family owned. Locally rooted. Here for your yard.</span></div>
          </div>
          <div class="services-intro-visual reveal" style="--reveal-delay: 170ms">
            <ImagePlaceholder label="A beautiful finished landscape photo here" description="A wide view of a Flores project, with the lawn and garden beds together." tone="dark" number="01" />
            <div class="services-experience"><strong>20<span>+</span></strong><span>YEARS OF<br />HANDS-ON CARE</span></div>
            <div class="services-photo-caption"><Leaf size={20} aria-hidden="true" /><span>A little pride in every detail.</span><span>FLORES LANDSCAPING</span></div>
          </div>
        </div>
        <div class="services-local reveal"><span><MapPin size={17} aria-hidden="true" /> YOUR LOCAL LANDSCAPING TEAM</span><p>South Bend <b>·</b> Mishawaka <b>·</b> Granger <b>·</b> Osceola</p></div>
      </div>
    </section>

    <section id="our-services" class="service-explorer section-pad" aria-labelledby="service-explorer-title">
      <div class="container">
        <div class="service-explorer-heading reveal"><div><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> THE RIGHT CARE, RIGHT HERE</div><h2 id="service-explorer-title">Your space.<br />Our kind of <em>work.</em></h2></div><p>A fresh start, a seasonal refresh, or a little everyday upkeep. Explore the ways we can help.</p></div>
        <div class="service-explorer-grid">
          <div class="service-preview reveal">
            <div class="service-preview-panels">
              {serviceOfferings.map((service, i) => <div class="service-preview-panel" data-service-preview={service.id} hidden={i !== 0}>
                <ImagePlaceholder label={service.photo} description={service.photoDetail} number={`0${i + 1} / 07`} />
                <div class="service-preview-caption"><span>{service.title}</span><p>{service.caption}</p></div>
              </div>)}
            </div>
            <a class="text-link" href="/#projects">SEE THE DIFFERENCE WE MAKE <ArrowRight size={18} aria-hidden="true" /></a>
          </div>
          <div class="service-accordion reveal" style="--reveal-delay: 100ms">
            {serviceOfferings.map(({ icon: Icon, ...service }, i) => <details class="service-detail" name="service-overview" id={service.id} open={i === 0}>
              <summary><span class="service-detail-number">0{i + 1}</span><Icon size={25} stroke-width={1.4} aria-hidden="true" /><h3>{service.title}</h3><span class="service-detail-toggle"><Plus size={19} aria-hidden="true" /></span></summary>
              <div class="service-detail-body">
                <p>{service.description}</p>
                <ul>{service.highlights.map(highlight => <li><Check size={14} aria-hidden="true" />{highlight}</li>)}</ul>
                <div class="service-mobile-photo"><ImagePlaceholder label={service.photo} compact /></div>
                <a class="text-link" href={`/services/${service.id}/`} aria-label={`Explore ${service.title}`}>EXPLORE THIS SERVICE <ArrowUpRight size={17} aria-hidden="true" /></a>
              </div>
            </details>)}
          </div>
        </div>
      </div>
    </section>

    <section class="services-property-band" aria-labelledby="services-property-title">
      <div class="container services-property-grid">
        <div class="reveal"><div class="eyebrow">SAME PRIDE. EVERY PROPERTY.</div><h2 id="services-property-title">At home.<br />At work.<br /><span>Always with care.</span></h2></div>
        <div class="services-property-types" data-reveal-group>
          <article><House size={33} stroke-width={1.2} aria-hidden="true" /><div><h3>For your home.</h3><p>A welcoming front yard. A backyard to enjoy. Care for the outdoor spaces that are part of your everyday life.</p></div></article>
          <article><Building size={33} stroke-width={1.2} aria-hidden="true" /><div><h3>For your business.</h3><p>Make a good first impression with outdoor spaces that reflect the care you put into your business.</p></div></article>
        </div>
      </div>
    </section>

    <section class="services-process section-pad" aria-labelledby="services-process-title">
      <div class="container">
        <div class="section-heading reveal"><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> FROM HELLO TO SOMETHING BEAUTIFUL</div><h2 id="services-process-title">Good things start<br />with a <em>conversation.</em></h2><p>A few simple steps. A team that cares from the start.</p></div>
        <ol class="services-steps" data-reveal-group>{steps.map(({ icon: Icon, ...step }) => <li><div class="services-step-marker"><span>{step.number}</span><Icon size={26} stroke-width={1.4} aria-hidden="true" /></div><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
      </div>
    </section>

    <section id="estimate" class="services-estimate" aria-labelledby="services-estimate-title">
      <div class="container services-estimate-grid">
        <div class="reveal"><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> A BETTER YARD STARTS HERE</div><h2 id="services-estimate-title">What can we<br />help you <em>grow?</em></h2><p>Tell us about your property and what you have in mind. We’ll help you find a good place to start.</p><div class="services-estimate-trust"><span><BadgeCheck size={18} aria-hidden="true" /> Licensed & insured</span><span><Check size={18} aria-hidden="true" /> Free estimates</span></div></div>
        <div class="services-estimate-contact reveal" style="--reveal-delay: 100ms"><span>CALL OR TEXT OUR TEAM</span><a class="services-estimate-phone" href="tel:+15743866078">(574) 386-6078 <ArrowUpRight size={30} aria-hidden="true" /></a><p>South Bend, Mishawaka, Granger & Osceola</p><a class="button button-red" href="sms:+15743866078">LET’S TALK ABOUT YOUR YARD <MessageCircle size={18} aria-hidden="true" /></a><a class="services-estimate-email" href="mailto:floreslandscaping098@gmail.com">Prefer email? We’d love to hear from you. <ArrowRight size={16} aria-hidden="true" /></a></div>
      </div>
    </section>
  </main>
  <Footer />
  <script>import '../scripts/services-page';</script>
</BaseLayout>

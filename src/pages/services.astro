---
import rawContent from '../content/services-overview.json';
import { readContent, resolvePhoto, safeLink, business, phoneHref, emailHref, serviceAreas } from '../lib/cms';
const content = readContent(rawContent);
import { ArrowDown, ArrowRight, ArrowUpRight, BadgeCheck, Building, Check, ChevronRight, House, Leaf, MapPin, MessageCircle, Plus, Sprout, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ClientPhoto from '../components/ClientPhoto.astro';
import { servicePhotos } from '../data/client-photos';
import { serviceOfferings } from '../data/services';
import '../styles/services.css';

const steps = Object.values(content.steps).map((item, index) => ({ ...item, icon: [MessageCircle,House,Sprout][index], number: String(index + 1).padStart(2, '0') }));
---
<BaseLayout title={content.seo.title} description={content.seo.description}>
  <div id="top"></div>
  <Header />
  <main id="main" class="services-page">
    <section class="services-intro" aria-labelledby="services-title">
      <div class="container">
        <nav class="services-breadcrumb" aria-label="Breadcrumb"><a href={safeLink(content.servicesIntro.link)}>{content.servicesIntro.linkLabel}</a><ChevronRight size={13} aria-hidden="true" /><span aria-current="page">{content.servicesIntro.text}</span></nav>
        <div class="services-intro-grid">
          <div class="services-intro-copy" data-reveal-group>
            <div class="eyebrow"><Leaf size={18} aria-hidden="true" /> {content.servicesIntro.eyebrow}</div>
            <h1 id="services-title">{content.servicesIntro.heading}<br />{content.servicesIntro.heading2}<br /><em>{content.servicesIntro.text2}</em></h1>
            <p>{content.servicesIntro.paragraph}</p>
            <div class="services-intro-actions"><a class="button button-red" href={safeLink(content.servicesIntro.link2)}>{content.servicesIntro.linkLabel2} <ArrowDown size={17} aria-hidden="true" /></a><a class="text-link" href={safeLink(content.servicesIntro.link3)}>{content.servicesIntro.linkLabel3} <ArrowUpRight size={18} aria-hidden="true" /></a></div>
            <div class="services-intro-note"><Users size={18} aria-hidden="true" /><span>{content.servicesIntro.text3}</span></div>
          </div>
          <div class="services-intro-visual reveal" style="--reveal-delay: 170ms">
            <ClientPhoto {...resolvePhoto(content.servicesIntro.photo)} eager />
            <div class="services-experience"><strong>{business.experienceYears}<span>+</span></strong><span>{content.servicesIntro.text4}<br />{content.servicesIntro.text5}</span></div>
            <div class="services-photo-caption"><Leaf size={20} aria-hidden="true" /><span>{content.servicesIntro.text6}</span><span>{content.servicesIntro.text7}</span></div>
          </div>
        </div>
        <div class="services-local reveal"><span><MapPin size={17} aria-hidden="true" /> {content.servicesIntro.text8}</span><p>{serviceAreas.map((city, i) => <>{i > 0 && <> <b>·</b> </>}{city}</>)}</p></div>
      </div>
    </section>

    <section id="our-services" class="service-explorer section-pad" aria-labelledby="service-explorer-title">
      <div class="container">
        <div class="service-explorer-heading reveal"><div><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> {content.ourServices.eyebrow}</div><h2 id="service-explorer-title">{content.ourServices.heading}<br />{content.ourServices.heading2} <em>{content.ourServices.text}</em></h2></div><p>{content.ourServices.paragraph}</p></div>
        <div class="service-explorer-grid">
          <div class="service-preview reveal">
            <div class="service-preview-panels">
              {serviceOfferings.map((service, i) => <div class="service-preview-panel" data-service-preview={service.id} hidden={i !== 0}>
                {servicePhotos[service.id]?.preview && <ClientPhoto {...servicePhotos[service.id]!.preview!} />}
                <div class="service-preview-caption"><span>{service.title}</span><p>{service.caption}</p></div>
              </div>)}
            </div>
            <a class="text-link" href={safeLink(content.ourServices.link)}>{content.ourServices.linkLabel} <ArrowRight size={18} aria-hidden="true" /></a>
          </div>
          <div class="service-accordion reveal" style="--reveal-delay: 100ms">
            {serviceOfferings.map(({ icon: Icon, ...service }, i) => <details class="service-detail" name="service-overview" id={service.id} open={i === 0}>
              <summary><span class="service-detail-number">0{i + 1}</span><Icon size={25} stroke-width={1.4} aria-hidden="true" /><h3>{service.title}</h3><span class="service-detail-toggle"><Plus size={19} aria-hidden="true" /></span></summary>
              <div class="service-detail-body">
                <p>{service.description}</p>
                <ul>{service.highlights.map(highlight => <li><Check size={14} aria-hidden="true" />{highlight}</li>)}</ul>
                {servicePhotos[service.id]?.preview && <div class="service-mobile-photo"><ClientPhoto {...servicePhotos[service.id]!.preview!} /></div>}
                <a class="text-link" href={safeLink(service.link)} aria-label={`Explore ${service.title}`}>{content.ourServices.linkLabel2} <ArrowUpRight size={17} aria-hidden="true" /></a>
              </div>
            </details>)}
          </div>
        </div>
      </div>
    </section>

    <section class="services-property-band" aria-labelledby="services-property-title">
      <div class="container services-property-grid">
        <div class="reveal"><div class="eyebrow">{content.servicesPropertyBand.eyebrow}</div><h2 id="services-property-title">{content.servicesPropertyBand.heading}<br />{content.servicesPropertyBand.heading2}<br /><span>{content.servicesPropertyBand.text}</span></h2></div>
        <div class="services-property-types" data-reveal-group>
          <article><House size={33} stroke-width={1.2} aria-hidden="true" /><div><h3>{content.servicesPropertyBand.heading3}</h3><p>{content.servicesPropertyBand.paragraph}</p></div></article>
          <article><Building size={33} stroke-width={1.2} aria-hidden="true" /><div><h3>{content.servicesPropertyBand.heading4}</h3><p>{content.servicesPropertyBand.paragraph2}</p></div></article>
        </div>
      </div>
    </section>

    <section class="services-process section-pad" aria-labelledby="services-process-title">
      <div class="container">
        <div class="section-heading reveal"><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> {content.servicesProcess.eyebrow}</div><h2 id="services-process-title">{content.servicesProcess.heading}<br />{content.servicesProcess.heading2} <em>{content.servicesProcess.text}</em></h2><p>{content.servicesProcess.paragraph}</p></div>
        <ol class="services-steps" data-reveal-group>{steps.map(({ icon: Icon, ...step }) => <li><div class="services-step-marker"><span>{step.number}</span><Icon size={26} stroke-width={1.4} aria-hidden="true" /></div><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
      </div>
    </section>

    <section id="estimate" class="services-estimate" aria-labelledby="services-estimate-title">
      <div class="container services-estimate-grid">
        <div class="reveal"><div class="eyebrow"><Leaf size={18} aria-hidden="true" /> {content.estimate.eyebrow}</div><h2 id="services-estimate-title">{content.estimate.heading}<br />{content.estimate.heading2} <em>{content.estimate.text}</em></h2><p>{content.estimate.paragraph}</p><div class="services-estimate-trust"><span><BadgeCheck size={18} aria-hidden="true" /> {content.estimate.text2}</span><span><Check size={18} aria-hidden="true" /> {content.estimate.text3}</span></div></div>
        <div class="services-estimate-contact reveal" style="--reveal-delay: 100ms"><span>{content.estimate.text4}</span><a class="services-estimate-phone" href={phoneHref}>{business.primaryPhone} <ArrowUpRight size={30} aria-hidden="true" /></a><p>{content.estimate.paragraph2}</p><a class="button button-red" href={safeLink(content.estimate.link)}>{content.estimate.linkLabel} <MessageCircle size={18} aria-hidden="true" /></a><a class="services-estimate-email" href={emailHref}>{content.estimate.linkLabel2} <ArrowRight size={16} aria-hidden="true" /></a></div>
      </div>
    </section>
  </main>
  <Footer />
  <script>import '../scripts/services-page';</script>
</BaseLayout>

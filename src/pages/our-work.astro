---
import { ArrowDown, ArrowRight, ArrowUpRight, ChevronLeft, ChevronRight, Images, Leaf, MapPin, MessageCircle } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import ComparisonPlaceholder from '../components/ComparisonPlaceholder.astro';
import { comparisons, galleryCategories, gallerySlots } from '../data/work';
import '../styles/work.css';
---
<BaseLayout title="Our Work & Landscaping Gallery | Flores Landscaping, South Bend" description="Explore the Flores Landscaping project gallery and before-and-after collection. Lawn care, landscaping, garden beds, and trimming around South Bend. Project photos coming soon.">
  <div id="top"></div>
  <Header />
  <main id="main" class="work-page">
    <section class="work-intro" aria-labelledby="work-title">
      <div class="container">
        <nav class="work-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><ChevronRight size={13} aria-hidden="true" /><span aria-current="page">Our work</span></nav>
        <div class="work-intro-copy" data-reveal-group><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> A CLOSER LOOK AT OUR WORK</div><h1 id="work-title">In every yard,<br /><em>there’s possibility.</em></h1><p>A fresh first impression. A more inviting backyard. Details that bring it all together. Take a closer look at the difference thoughtful care can make.</p><div class="work-intro-actions"><a class="button button-red" href="#before-after">BEFORE & AFTER <ArrowDown size={17} aria-hidden="true" /></a><a class="text-link" href="#gallery">BROWSE THE GALLERY <ArrowRight size={18} aria-hidden="true" /></a></div></div>
        <div class="work-intro-footer"><span><MapPin size={17} aria-hidden="true" /> SOUTH BEND & NEARBY COMMUNITIES</span><span><Images size={17} aria-hidden="true" /> PROJECT PHOTOS COMING SOON</span></div>
      </div>
    </section>

    <section id="before-after" class="work-transformations section-pad" aria-labelledby="work-transformations-title">
      <div class="container">
        <div class="work-section-heading reveal"><div><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> A LITTLE BEFORE. A BEAUTIFUL AFTER.</div><h2 id="work-transformations-title">The same space.<br /><em>A fresh start.</em></h2></div><p>Every transformation has a starting point. This collection will bring both sides of the story together, one yard at a time.</p></div>
        <div class="work-comparison-grid reveal" id="project-track" role="region" aria-label="Before-and-after photo previews" tabindex="0">{comparisons.map(comparison => <ComparisonPlaceholder {...comparison} />)}</div>
        <div class="project-navigation work-comparison-nav" hidden><span>Swipe to explore <span id="project-count" aria-live="polite" aria-atomic="true">01 / 03</span></span><div class="flex gap-2"><button class="circle-button" id="project-prev" aria-label="Previous comparison preview" aria-controls="project-track"><ChevronLeft size={20} aria-hidden="true" /></button><button class="circle-button" id="project-next" aria-label="Next comparison preview" aria-controls="project-track"><ChevronRight size={20} aria-hidden="true" /></button></div></div>
        <p class="work-photo-note"><Images size={17} aria-hidden="true" /> Before-and-after photos are on the way. These spaces preview the collection.</p>
      </div>
    </section>

    <section id="gallery" class="work-gallery section-pad" aria-labelledby="work-gallery-title">
      <div class="container">
        <div class="work-section-heading reveal"><div><div class="eyebrow"><Images size={18} aria-hidden="true" /> THE FLORES GALLERY</div><h2 id="work-gallery-title">Good things grow.<br /><em>Take a look around.</em></h2></div><p>From the whole landscape to the smallest finishing touch. A collection of lawns, gardens, and outdoor spaces cared for by Flores.</p></div>
        <div class="work-gallery-toolbar"><div class="work-gallery-filters" role="group" aria-label="Filter gallery by service" hidden>{galleryCategories.map(category => <button type="button" data-gallery-filter={category.id} aria-pressed={category.id === 'all' ? 'true' : 'false'} aria-controls="work-gallery-grid">{category.label}</button>)}</div><p id="work-gallery-status" role="status" aria-atomic="true">6 photo placeholders</p></div>
        <div class="work-gallery-grid" id="work-gallery-grid" data-reveal-group>{gallerySlots.map((item, index) => <article class="work-gallery-card" data-gallery-category={item.category}><ImagePlaceholder label={item.photo} number={`0${index + 1}`} /><div class="work-gallery-caption"><span>{galleryCategories.find(category => category.id === item.category)?.label}</span><h3>{item.title}</h3><p>Project photo coming soon.</p></div></article>)}</div>
      </div>
    </section>

    <section id="estimate" class="work-estimate" aria-labelledby="work-estimate-title">
      <div class="container work-estimate-grid"><div class="reveal"><div class="eyebrow">A LITTLE INSPIRATION. YOUR NEXT STEP.</div><h2 id="work-estimate-title">Picture the possibilities<br /><em>for your own yard.</em></h2><p>Tell us about the space you’d love to change. We’ll talk through your ideas and start with a free estimate.</p><a class="text-link" href="/services/">EXPLORE OUR SERVICES <ArrowRight size={18} aria-hidden="true" /></a></div><div class="work-estimate-contact reveal" style="--reveal-delay: 100ms"><span>CALL OR TEXT OUR TEAM</span><a class="work-phone" href="tel:+15743866078">(574) 386-6078 <ArrowUpRight size={26} aria-hidden="true" /></a><a class="button button-red" href="/contact/#estimate">REQUEST A FREE ESTIMATE <MessageCircle size={18} aria-hidden="true" /></a><a class="work-email" href="mailto:floreslandscaping098@gmail.com">Prefer email? Let’s talk. <ArrowRight size={16} aria-hidden="true" /></a></div></div>
    </section>
  </main>
  <Footer />
  <script>
    import '../scripts/project-comparisons';
    import '../scripts/work-gallery';
    import { initReveals } from '../scripts/scroll-reveals';
    initReveals();
  </script>
</BaseLayout>

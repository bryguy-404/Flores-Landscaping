---
import { ArrowDown, ArrowRight, ArrowUpRight, ChevronLeft, ChevronRight, Images, Leaf, MapPin, MessageCircle, Play } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image, getImage } from 'astro:assets';
import PhotoViewer from '../components/PhotoViewer.astro';
import VideoViewer from '../components/VideoViewer.astro';
import ProjectComparison from '../components/ProjectComparison.astro';
import { comparisons, galleryCategories, galleryPhotos } from '../data/work';
import { workVideos } from '../data/videos';
import '../styles/work.css';
const gallery = await Promise.all(galleryPhotos.map(async photo => ({ ...photo, full: (await getImage({ src: photo.src, width: Math.min(photo.src.width, Math.round(1600 * photo.src.width / Math.max(photo.src.width, photo.src.height))), format: 'webp', quality: 80 })).src })));
const videos = await Promise.all(workVideos.map(async video => ({ ...video, playerPoster: (await getImage({ src: video.poster, width: 720, format: 'webp', quality: 80 })).src })));
---
<BaseLayout title="Our Work & Landscaping Gallery | Flores Landscaping, South Bend" description="Explore Flores Landscaping before-and-afters, project photos, and videos. See lawn care, garden beds, seasonal cleanup, and snow plowing around South Bend.">
  <div id="top"></div>
  <Header />
  <main id="main" class="work-page">
    <section class="work-intro" aria-labelledby="work-title">
      <div class="container">
        <nav class="work-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><ChevronRight size={13} aria-hidden="true" /><span aria-current="page">Our work</span></nav>
        <div class="work-intro-copy" data-reveal-group><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> A CLOSER LOOK AT OUR WORK</div><h1 id="work-title">In every yard,<br /><em>there’s possibility.</em></h1><p>A fresh first impression. A more inviting backyard. Details that bring it all together. Take a closer look at the difference thoughtful care can make.</p><div class="work-intro-actions"><a class="button button-red" href="#before-after">BEFORE & AFTER <ArrowDown size={17} aria-hidden="true" /></a><a class="text-link" href="#gallery">BROWSE THE GALLERY <ArrowRight size={18} aria-hidden="true" /></a></div></div>
        <div class="work-intro-footer"><span><MapPin size={17} aria-hidden="true" /> SOUTH BEND & NEARBY COMMUNITIES</span><span><Images size={17} aria-hidden="true" /> REAL YARDS. THOUGHTFUL CARE.</span></div>
      </div>
    </section>

    <section id="before-after" class="work-transformations section-pad" aria-labelledby="work-transformations-title">
      <div class="container">
        <div class="work-section-heading reveal"><div><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> A LITTLE BEFORE. A BEAUTIFUL AFTER.</div><h2 id="work-transformations-title">The same space.<br /><em>A fresh start.</em></h2></div><p>Every transformation has a starting point. See both sides of the story, from overgrown beds to fresh mulch, clean borders, and new planting.</p></div>
        <div class="work-comparison-grid reveal" id="project-track" role="region" aria-label="Before-and-after projects" tabindex="0">{comparisons.map(comparison => <ProjectComparison {...comparison} variant="work" />)}</div>
        <div class="project-navigation work-comparison-nav" hidden><span>Swipe to explore <span id="project-count" aria-live="polite" aria-atomic="true">01 / 03</span></span><div class="flex gap-2"><button class="circle-button" id="project-prev" aria-label="Previous comparison" aria-controls="project-track"><ChevronLeft size={20} aria-hidden="true" /></button><button class="circle-button" id="project-next" aria-label="Next comparison" aria-controls="project-track"><ChevronRight size={20} aria-hidden="true" /></button></div></div>
        <p class="work-photo-note"><Images size={17} aria-hidden="true" /> Open any comparison to see both full photos.</p>
      </div>
    </section>

    <section id="gallery" class="work-gallery section-pad" aria-labelledby="work-gallery-title">
      <div class="container">
        <div class="work-section-heading reveal"><div><div class="eyebrow"><Images size={18} aria-hidden="true" /> THE FLORES GALLERY</div><h2 id="work-gallery-title">Good things grow.<br /><em>Take a look around.</em></h2></div><p>From the whole landscape to the smallest finishing touch. A collection of lawns, gardens, and outdoor spaces cared for by Flores.</p></div>
        <div class="work-gallery-toolbar"><div class="work-gallery-filters" role="group" aria-label="Filter gallery by service" hidden>{galleryCategories.map(category => <button type="button" data-gallery-filter={category.id} aria-pressed={category.id === 'all' ? 'true' : 'false'} aria-controls="work-gallery-grid">{category.label}</button>)}</div><p id="work-gallery-status" role="status" aria-atomic="true">9 project photos</p></div>
        <div class="work-gallery-grid" id="work-gallery-grid" data-reveal-group>{gallery.map(item => <article class="work-gallery-card" data-gallery-category={item.category}>
          <a class="work-gallery-photo" href={item.full} data-photo-open data-photo-title={item.title} data-photo-alt={item.alt} aria-label={`Enlarge: ${item.title}`}><Image src={item.src} alt={item.alt} width={Math.min(1080, item.src.width)} widths={[480, 800, 1080].filter(width => width <= item.src.width)} sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw" format="webp" loading="lazy" /><span aria-hidden="true">VIEW PHOTO <ArrowUpRight size={17} /></span></a>
          <div class="work-gallery-caption"><span>{galleryCategories.find(category => category.id === item.category)?.label}</span><h3>{item.title}</h3></div>
        </article>)}</div>
      </div>
    </section>

    <section id="videos" class="work-videos section-pad" aria-labelledby="work-videos-title">
      <div class="container">
        <div class="work-section-heading reveal"><div><div class="eyebrow"><Play size={18} aria-hidden="true" /> A FEW MOMENTS OUTSIDE</div><h2 id="work-videos-title">Our work.<br /><em>In action.</em></h2></div><p>Fresh cuts, seasonal changes, and a closer look around. Short videos from the spaces we care for, throughout the year.</p></div>
        <div class="work-video-grid" id="work-video-grid" data-reveal-group>
          {videos.map(video => <article class="work-video-card" data-video-card>
            <a class="work-video-preview" href={video.src} data-video-open data-video-title={video.title} data-video-description={video.description} data-video-poster={video.playerPoster} aria-label={`Play ${video.title} ${video.duration}`}>
              <Image src={video.poster} alt="" width={540} widths={[270, 540, 720]} sizes="(max-width: 767px) 45vw, (max-width: 1023px) 45vw, 25vw" format="webp" loading="lazy" />
              <span class="work-video-play"><Play size={23} fill="currentColor" aria-hidden="true" /></span>
              <span class="work-video-duration" aria-hidden="true">{video.duration}</span>
            </a>
            <div class="work-video-caption"><span>{video.category}</span><h3>{video.title}</h3></div>
          </article>)}
        </div>
        <div class="work-video-controls"><p id="work-video-status" role="status" aria-atomic="true">{videos.length} videos</p><button type="button" class="button button-red" id="work-videos-more" aria-expanded="false" aria-controls="work-video-grid" hidden>View more videos</button></div>
      </div>
    </section>

    <section id="estimate" class="work-estimate" aria-labelledby="work-estimate-title">
      <div class="container work-estimate-grid"><div class="reveal"><div class="eyebrow">A LITTLE INSPIRATION. YOUR NEXT STEP.</div><h2 id="work-estimate-title">Picture the possibilities<br /><em>for your own yard.</em></h2><p>Tell us about the space you’d love to change. We’ll talk through your ideas and start with a free estimate.</p><a class="text-link" href="/services/">EXPLORE OUR SERVICES <ArrowRight size={18} aria-hidden="true" /></a></div><div class="work-estimate-contact reveal" style="--reveal-delay: 100ms"><span>CALL OR TEXT OUR TEAM</span><a class="work-phone" href="tel:+15743866078">(574) 386-6078 <ArrowUpRight size={26} aria-hidden="true" /></a><a class="button button-red" href="/contact/#estimate">REQUEST A FREE ESTIMATE <MessageCircle size={18} aria-hidden="true" /></a><a class="work-email" href="mailto:floreslandscaping098@gmail.com">Prefer email? Let’s talk. <ArrowRight size={16} aria-hidden="true" /></a></div></div>
    </section>
  </main>
  <Footer />
  <PhotoViewer />
  <VideoViewer />
  <script>
    import '../scripts/project-comparisons';
    import '../scripts/work-gallery';
    import '../scripts/work-videos';
    import { initReveals } from '../scripts/scroll-reveals';
    initReveals();
  </script>
</BaseLayout>

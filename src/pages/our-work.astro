---
import rawContent from '../content/our-work.json';
import { business, readContent, safeLink, phoneHref, emailHref } from '../lib/cms';
const content = readContent(rawContent);
import { ArrowDown, ArrowRight, ArrowUpRight, ChevronDown, ChevronLeft, ChevronRight, Expand, Images, Leaf, MapPin, MessageCircle, Play } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import Image from '../components/CmsImage.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import VideoViewer from '../components/VideoViewer.astro';
import ProjectComparison from '../components/ProjectComparison.astro';
import { comparisons, moreComparisons, galleryCategories, galleryPhotos } from '../data/work';
import { workVideos } from '../data/videos';
import '../styles/work.css';
const gallery = await Promise.all(galleryPhotos.map(async photo => ({ ...photo, full: (await getImage({ src: photo.src, width: Math.min(photo.src.width, Math.round(1600 * photo.src.width / Math.max(photo.src.width, photo.src.height))), format: 'webp', quality: 80 })).src })));
const videos = await Promise.all(workVideos.map(async video => ({ ...video, playerPoster: (await getImage({ src: video.poster, width: 720, format: 'webp', quality: 80 })).src })));
const stageLabels = { before: 'Before', progress: 'In progress', finished: 'Finished work', project: 'Project detail' };
---
<BaseLayout title={content.seo.title} description={content.seo.description}>
  <div id="top"></div>
  <Header />
  <main id="main" class="work-page">
    <section class="work-intro" aria-labelledby="work-title">
      <div class="container">
        <nav class="work-breadcrumb" aria-label="Breadcrumb"><a href={safeLink(content.workIntro.link)}>{content.workIntro.linkLabel}</a><ChevronRight size={13} aria-hidden="true" /><span aria-current="page">{content.workIntro.text}</span></nav>
        <div class="work-intro-copy" data-reveal-group><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> {content.workIntro.eyebrow}</div><h1 id="work-title">{content.workIntro.heading}<br /><em>{content.workIntro.text2}</em></h1><p>{content.workIntro.paragraph}</p><div class="work-intro-actions"><a class="button button-red" href={safeLink(content.workIntro.link2)}>{content.workIntro.linkLabel2} <ArrowDown size={17} aria-hidden="true" /></a><a class="text-link" href={safeLink(content.workIntro.link3)}>{content.workIntro.linkLabel3} <ArrowRight size={18} aria-hidden="true" /></a></div></div>
        <div class="work-intro-footer"><span><MapPin size={17} aria-hidden="true" /> {content.workIntro.text3}</span><nav class="work-jump-links" aria-label="Explore our work"><a href={safeLink(content.workIntro.link4)}>{comparisons.length + moreComparisons.length} {content.workIntro.linkLabel4}</a><a href={safeLink(content.workIntro.link5)}>{gallery.length} {content.workIntro.linkLabel5}</a><a href={safeLink(content.workIntro.link6)}>{videos.length} {content.workIntro.linkLabel6}</a></nav></div>
      </div>
    </section>

    <section id="before-after" class="work-transformations section-pad" aria-labelledby="work-transformations-title">
      <div class="container">
        <div class="work-section-heading reveal"><div><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> {content.beforeAfter.eyebrow}</div><h2 id="work-transformations-title">{content.beforeAfter.heading}<br /><em>{content.beforeAfter.text}</em></h2></div><p>{content.beforeAfter.paragraph}</p></div>
        <div class="work-comparison-grid reveal" id="project-track" role="region" aria-label="Before-and-after projects" tabindex="0">{comparisons.map(comparison => <ProjectComparison {...comparison} variant="work" />)}</div>
        <div class="project-navigation work-comparison-nav" hidden><span>{content.beforeAfter.text2} <span id="project-count" aria-live="polite" aria-atomic="true">01 / 03</span></span><div class="flex gap-2"><button class="circle-button" id="project-prev" aria-label="Previous comparison" aria-controls="project-track"><ChevronLeft size={20} aria-hidden="true" /></button><button class="circle-button" id="project-next" aria-label="Next comparison" aria-controls="project-track"><ChevronRight size={20} aria-hidden="true" /></button></div></div>
        <p class="work-photo-note"><Images size={17} aria-hidden="true" /> {content.beforeAfter.paragraph2}</p>
        <details class="work-more-comparisons">
          <summary><span class="comparison-more-label">{content.beforeAfter.text3} {moreComparisons.length} {content.beforeAfter.text4}</span><span class="comparison-less-label">{content.beforeAfter.text5}</span><ChevronDown size={18} aria-hidden="true" /></summary>
          <div class="work-extra-comparison-grid" data-reveal-group>{moreComparisons.map(comparison => <ProjectComparison {...comparison} variant="work" />)}</div>
        </details>
      </div>
    </section>

    <section id="gallery" class="work-gallery section-pad" aria-labelledby="work-gallery-title">
      <div class="container">
        <div class="work-section-heading reveal"><div><div class="eyebrow"><Images size={18} aria-hidden="true" /> {content.gallery.eyebrow}</div><h2 id="work-gallery-title">{content.gallery.heading}<br /><em>{content.gallery.text}</em></h2></div><p>{content.gallery.paragraph}</p></div>
        <div class="work-gallery-toolbar"><div class="work-gallery-filters" role="group" aria-label="Filter gallery" hidden>{galleryCategories.map(category => <button type="button" data-gallery-filter={category.id} aria-pressed={category.id === 'all' ? 'true' : 'false'} aria-controls="work-gallery-grid">{category.label}</button>)}</div><p id="work-gallery-status" role="status" aria-atomic="true">{gallery.length} project photos</p></div>
        <div class="work-gallery-grid" id="work-gallery-grid">{gallery.map(item => <article class="work-gallery-card" data-gallery-category={item.category} data-gallery-stage={item.stage} data-gallery-id={item.id} data-gallery-ratio={item.src.width / item.src.height}>
          <a class="work-gallery-photo" style={`aspect-ratio: ${item.src.width} / ${item.src.height}`} href={item.full} data-photo-open data-photo-gallery data-photo-title={item.title} data-photo-caption={stageLabels[item.stage]} data-photo-alt={item.alt} aria-label={`Enlarge ${item.title} — ${stageLabels[item.stage]}`}><Image src={item.src} alt={item.alt} position={item.position} mobilePosition={item.mobilePosition} width={Math.min(800, item.src.width)} widths={[320, 480, 640, 800].filter(width => width <= item.src.width)} sizes="(max-width: 767px) 45vw, (max-width: 1023px) 30vw, 25vw" format="webp" loading="lazy" />{item.stage !== 'finished' && <span class="work-gallery-stage">{stageLabels[item.stage]}</span>}<span class="work-gallery-enlarge" aria-hidden="true"><Expand size={18} /></span></a>
        </article>)}</div>
        <div class="work-gallery-controls"><p>{content.gallery.paragraph2}</p><button type="button" class="button button-red" id="work-gallery-more" aria-expanded="false" aria-controls="work-gallery-grid" hidden>{content.gallery.text2} {gallery.length} {content.gallery.text3} <ArrowDown size={17} aria-hidden="true" /></button><a class="text-link" href={safeLink(content.gallery.link)}>{content.gallery.linkLabel} <Play size={16} aria-hidden="true" /></a></div>
      </div>
    </section>

    <section id="videos" class="work-videos section-pad" aria-labelledby="work-videos-title">
      <div class="container">
        <div class="work-section-heading reveal"><div><div class="eyebrow"><Play size={18} aria-hidden="true" /> {content.videos.eyebrow}</div><h2 id="work-videos-title">{content.videos.heading}<br /><em>{content.videos.text}</em></h2></div><p>{content.videos.paragraph}</p></div>
        <div class="work-video-grid" id="work-video-grid" data-reveal-group>
          {videos.map(video => <article class="work-video-card" data-video-card>
            <a class="work-video-preview" href={video.src} data-video-open data-video-title={video.title} data-video-description={video.description} data-video-poster={video.playerPoster} aria-label={`Play ${video.title} ${video.duration}`}>
              <Image src={video.poster} alt={video.posterAlt} position={video.position} mobilePosition={video.mobilePosition} width={540} widths={[270, 540, 720]} sizes="(max-width: 767px) 45vw, (max-width: 1023px) 45vw, 25vw" format="webp" loading="lazy" />
              <span class="work-video-play"><Play size={23} fill="currentColor" aria-hidden="true" /></span>
              <span class="work-video-duration" aria-hidden="true">{video.duration}</span>
            </a>
            <div class="work-video-caption"><span>{video.category}</span><h3>{video.title}</h3></div>
          </article>)}
        </div>
        <div class="work-video-controls"><p id="work-video-status" role="status" aria-atomic="true">{videos.length} videos</p><button type="button" class="button button-red" id="work-videos-more" aria-expanded="false" aria-controls="work-video-grid" hidden>{content.videos.text2}</button></div>
      </div>
    </section>

    <section id="estimate" class="work-estimate" aria-labelledby="work-estimate-title">
      <div class="container work-estimate-grid"><div class="reveal"><div class="eyebrow">{content.estimate.eyebrow}</div><h2 id="work-estimate-title">{content.estimate.heading}<br /><em>{content.estimate.text}</em></h2><p>{content.estimate.paragraph}</p><a class="text-link" href={safeLink(content.estimate.link)}>{content.estimate.linkLabel} <ArrowRight size={18} aria-hidden="true" /></a></div><div class="work-estimate-contact reveal" style="--reveal-delay: 100ms"><span>{content.estimate.text2}</span><a class="work-phone" href={phoneHref}>{business.primaryPhone} <ArrowUpRight size={26} aria-hidden="true" /></a><a class="button button-red" href={safeLink(content.estimate.link2)}>{content.estimate.linkLabel2} <MessageCircle size={18} aria-hidden="true" /></a><a class="work-email" href={emailHref}>{content.estimate.linkLabel3} <ArrowRight size={16} aria-hidden="true" /></a></div></div>
    </section>
  </main>
  <Footer />
  <PhotoViewer />
  <VideoViewer />
  <script>
    import '../scripts/project-comparisons';
    import '../scripts/work-gallery';
    import '../scripts/work-videos';
    import { initReveals } from '../scripts/scroll-reveals';
    initReveals();
  </script>
</BaseLayout>

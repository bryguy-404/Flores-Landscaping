---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight, ChevronLeft, ChevronRight, TreePine, Leaf, Sprout, House, Building, BadgeCheck, Phone, Mail, MapPin, Check, Shovel, Users, X, Plus, Pause, Play } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectComparison from '../components/ProjectComparison.astro';
import frontYardComparison from '../assets/front-yard-before-after.webp';
import hero from '../assets/lawn-stripes.jpg';
import hedgeHero from '../assets/hedge-hero.jpg';
import beds from '../assets/landscape-beds.jpg';
import flowers from '../assets/flower-garden.jpg';
import lawn from '../assets/lawn-care.jpg';
import mulch from '../assets/mulch.jpg';
import sod from '../assets/sod-installation.jpg';
import snow from '../assets/snow-removal.jpg';
import trimming from '../assets/trimming.jpg';
import garden from '../assets/garden-bed.jpg';
import { serviceOfferings } from '../data/services';

const servicePhotos = {
  'lawn-care': { image: lawn, alt: 'Freshly mowed lawn with even stripes' },
  'landscaping': { image: beds, alt: 'Curved planting beds with shrubs and decorative stone' },
  'mulch-planting': { image: flowers, alt: 'Colorful flowering plants in a landscaped garden bed' },
  'sod-installation': { image: sod, alt: 'Newly installed sod alongside a residential walkway' },
  'seasonal-cleanup': { image: garden, alt: 'Freshly maintained planting bed in a green lawn' },
  'trimming': { image: trimming, alt: 'Hedge trimming with a powered trimmer' },
  'snow-plowing': { image: snow, alt: 'Snow removal equipment working on a snowy property' },
};
const services = serviceOfferings.map(service => ({ ...service, ...servicePhotos[service.id] }));
const faqs = [
  { q: 'What areas do you serve?', a: 'We serve residential and commercial properties in South Bend, Mishawaka, Granger, and Osceola. If you’re nearby and aren’t sure whether we cover your area, give us a call or send us a text.' },
  { q: 'Do you offer free estimates?', a: 'Yes! We offer free estimates for lawn care and landscaping projects. Call or text us to tell us about your property and schedule a consultation.' },
  { q: 'Are you licensed and insured?', a: 'Yes, Flores Landscaping is fully licensed and insured. We take care to protect your property while delivering professional, reliable service.' },
  { q: 'Can you help throughout the year?', a: 'Yes. Our services include lawn care, landscape maintenance, spring and fall cleanups, and winter snow plowing. Contact us to discuss what your property needs this season.' },
];
---
<BaseLayout>
  <div id="home"></div>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title" aria-roledescription="carousel" aria-label="Flores landscaping photos">
      <div class="hero-images" id="hero-images" aria-live="off">
        <Image class="hero-image hero-image-hedge is-active" src={hedgeHero} alt="A landscaper carefully trimming a hedge" widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="eager" fetchpriority="high" />
        <Image class="hero-image" src={hero} alt="A freshly mowed Flores Landscaping lawn framed by mature trees" widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true" />
        <Image class="hero-image" src={beds} alt="Professionally maintained shrubs and landscape beds" widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true" />
        <Image class="hero-image" src={flowers} alt="A colorful flower garden beside a home" widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true" />
      </div>
      <div class="hero-shade"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow"><TreePine size={43} stroke-width={1.3} aria-hidden="true" /><span>Rooted in family.<br />Growing beautiful spaces.</span></div>
          <h1 id="hero-title">Beautiful landscapes.<br />Made for <span>living.</span></h1>
          <p>A little more green. A lot more care. Your local Flores team brings out the best in your outdoor space.</p>
          <div class="hero-actions flex flex-wrap gap-4">
            <a class="button button-red" href="#contact">GET A FREE ESTIMATE <ArrowUpRight size={18} aria-hidden="true" /></a>
            <a class="button button-outline" href="#projects">EXPLORE OUR WORK</a>
          </div>
        </div>
      </div>
      <button class="hero-arrow hero-prev" aria-label="Previous landscape photo"><ChevronLeft aria-hidden="true" /></button>
      <button class="hero-arrow hero-next" aria-label="Next landscape photo"><ChevronRight aria-hidden="true" /></button>
      <div class="container hero-bottom">
        <span class="hero-caption">LOCAL ROOTS. LASTING BEAUTY.</span>
        <div class="hero-playback">
          <div class="hero-dots" role="group" aria-label="Choose landscape photo">
            {[0, 1, 2, 3].map(i => <button class:list={[{ 'is-active': i === 0 }]} aria-label={`Show landscape photo ${i + 1}`} aria-pressed={i === 0} data-slide={i}></button>)}
          </div>
          <button id="hero-autoplay" class="autoplay-toggle" aria-label="Pause hero slideshow" aria-controls="hero-images" data-carousel-label="hero slideshow" hidden><Pause class="pause-icon" size={14} aria-hidden="true" /><Play class="play-icon" size={14} aria-hidden="true" /></button>
        </div>
      </div>
    </section>

    <section class="property-services container" aria-label="Residential and commercial landscaping" data-reveal-group>
      <a class="property-card" href="#contact">
        <div class="property-label"><House size={43} stroke-width={1.25} aria-hidden="true" /><h2>Residential<br />Services</h2><span>GET IN TOUCH <ArrowUpRight size={18} aria-hidden="true" /></span></div>
        <Image src={beds} alt="Well-maintained landscaping in front of a home" width={600} height={350} format="webp" loading="lazy" />
      </a>
      <a class="property-card" href="#contact">
        <div class="property-label"><Building size={43} stroke-width={1.25} aria-hidden="true" /><h2>Commercial<br />Services</h2><span>GET IN TOUCH <ArrowUpRight size={18} aria-hidden="true" /></span></div>
        <Image src={hero} alt="Wide, neatly maintained green lawn" width={600} height={350} format="webp" loading="lazy" />
      </a>
    </section>

    <section id="about" class="about-section section-pad">
      <div class="container about-grid">
        <div class="about-visual reveal">
          <div class="about-photo-main"><Image src={beds} alt="Flores landscaping with curved stone beds and carefully trimmed shrubs" width={750} height={920} format="webp" loading="lazy" /></div>
          <div class="about-photo-detail"><Image src={mulch} alt="Red mulch and decorative white rock around trees" width={430} height={460} format="webp" loading="lazy" /></div>
          <div class="experience-badge"><strong>20<span>+</span></strong><span>YEARS OF<br />HANDS-ON CARE</span></div>
          <span class="image-footnote">A little pride in every detail.</span>
        </div>
        <div class="about-copy reveal" style="--reveal-delay: 100ms">
          <div class="eyebrow"><Leaf size={19} aria-hidden="true" /> ABOUT FLORES LANDSCAPING</div>
          <h2>Your yard.<br />Our family’s <em>pride.</em></h2>
          <p class="lead">Good landscaping starts with people who care.</p>
          <p>We’re a family-owned team with more than 20 years of experience caring for outdoor spaces around South Bend. From a freshly cut lawn to a whole new landscape, we bring a personal touch to every job.</p>
          <div class="about-values">
            <div><span class="value-icon"><Sprout size={27} stroke-width={1.5} aria-hidden="true" /></span><div><h3>Care that goes beyond the cut</h3><p>Thoughtful work, from the first visit to the finishing touches.</p></div></div>
            <div><span class="value-icon"><Users size={27} stroke-width={1.5} aria-hidden="true" /></span><div><h3>Your neighbors, your landscaping team</h3><p>Local experience. Friendly faces. Pride in our community.</p></div></div>
          </div>
          <a class="text-link" href="#contact">LET’S TALK ABOUT YOUR PROPERTY <ArrowRight size={20} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="container trust-strip reveal"><span><BadgeCheck size={20} aria-hidden="true" /> LICENSED & INSURED</span><span><Users size={20} aria-hidden="true" /> FAMILY OWNED & OPERATED</span><span><Check size={20} aria-hidden="true" /> FREE, NO-OBLIGATION ESTIMATES</span></div>
    </section>

    <section id="services" class="services-section section-pad">
      <div class="container">
        <div class="section-heading reveal"><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> A LITTLE CARE. A BIG DIFFERENCE.</div><h2>Good things grow<br />with the right <em>care.</em></h2><p>Everything your outdoor space needs, from the ground up.</p></div>
        <div class="service-carousel reveal">
          <div class="service-track" id="service-track" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Landscaping services" aria-live="off">
            {services.map(({ icon: Icon, ...service }, i) => <article class="service-card">
              <div class="service-photo"><Image src={service.image} alt={service.alt} width={700} height={510} format="webp" loading="lazy" /><span class="service-icon"><Icon size={30} stroke-width={1.5} aria-hidden="true" /></span><span class="service-number">0{i + 1}</span></div>
              <div class="service-content"><h3>{service.title}</h3><p>{service.summary}</p><a href={`/services/${service.id}/`} class="text-link" aria-label={`Explore ${service.title}`}>EXPLORE THIS SERVICE <ArrowUpRight size={18} aria-hidden="true" /></a></div>
            </article>)}
          </div>
        </div>
        <div class="service-controls"><span>Lawn care to seasonal cleanups. We’ve got you covered.</span><div class="service-playback flex gap-2"><button id="services-autoplay" class="circle-button autoplay-toggle" aria-label="Pause services carousel" aria-controls="service-track" data-carousel-label="services carousel" hidden><Pause class="pause-icon" size={16} aria-hidden="true" /><Play class="play-icon" size={16} aria-hidden="true" /></button><button class="circle-button" id="service-prev" aria-label="Previous services" aria-controls="service-track"><ChevronLeft size={20} aria-hidden="true" /></button><button class="circle-button" id="service-next" aria-label="Next services" aria-controls="service-track"><ChevronRight size={20} aria-hidden="true" /></button></div></div>
      </div>
    </section>

    <section id="projects" class="projects-section section-pad" aria-labelledby="projects-title">
      <div class="container projects-heading reveal"><div><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> A LITTLE BEFORE. A BEAUTIFUL AFTER.</div><h2 id="projects-title">Real yards.<br /><em>Real transformations.</em></h2></div><p>See the difference a little care and craftsmanship can make, one outdoor space at a time.</p></div>
      <div class="project-grid reveal" id="project-track" role="region" aria-label="Before-and-after projects" tabindex="0">
        <ProjectComparison id="front-yard" title="A fresh start out front" category="Landscaping & garden beds" before={frontYardComparison} after={frontYardComparison} beforeAlt="Before: overgrown planting beds in front of a brick home" afterAlt="After: refreshed stone beds and neatly spaced shrubs at the same home" collage />
        {[{ number: '02', icon: Sprout }, { number: '03', icon: TreePine }].map(({ number, icon: Icon }) => <article class="project-card project-placeholder" aria-label={`Project ${number}: before-and-after photos coming soon`}>
          <div class="comparison-stage">
            <div class="placeholder-halves" aria-hidden="true"></div>
            <div class="comparison-labels" aria-hidden="true"><span>BEFORE</span><span>AFTER</span></div>
            <div class="placeholder-art" aria-hidden="true"><Icon size={64} stroke-width={1} /></div>
            <div class="project-overlay"><div><small>Project {number} · Coming soon</small><h3>More beauty<br />in the making.</h3></div></div>
          </div>
          <div class="placeholder-footer">Before & after photos coming soon</div>
        </article>)}
      </div>
      <div class="project-navigation container" hidden>
        <span>Swipe to explore <span id="project-count" aria-live="polite" aria-atomic="true">01 / 03</span></span>
        <div class="flex gap-2"><button class="circle-button" id="project-prev" aria-label="Previous transformation" aria-controls="project-track"><ChevronLeft size={20} aria-hidden="true" /></button><button class="circle-button" id="project-next" aria-label="Next transformation" aria-controls="project-track"><ChevronRight size={20} aria-hidden="true" /></button></div>
      </div>
    </section>

    <section class="promise-band" aria-label="The Flores difference">
      <div class="container promise-grid" data-reveal-group>
        <div><TreePine size={39} stroke-width={1.3} aria-hidden="true" /><strong>20<span>+</span></strong><span>Years of experience</span></div>
        <div><Users size={39} stroke-width={1.3} aria-hidden="true" /><strong>Family</strong><span>Owned & operated</span></div>
        <div><BadgeCheck size={39} stroke-width={1.3} aria-hidden="true" /><strong>Local</strong><span>Care you can count on</span></div>
        <div><Shovel size={39} stroke-width={1.3} aria-hidden="true" /><strong>Every season</strong><span>Here for your outdoor space</span></div>
      </div>
    </section>

    <section id="faq" class="faq-section section-pad">
      <div class="container faq-grid">
        <div class="reveal"><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> GOOD TO KNOW</div><h2>A few questions,<br /><em>before we grow.</em></h2><p>Getting started should feel easy. Here are a few things you might be wondering.</p><a class="text-link" href="tel:+15743866078">WE’RE ALWAYS HAPPY TO HELP <ArrowUpRight size={20} aria-hidden="true" /></a></div>
        <div class="faq-list reveal" style="--reveal-delay: 100ms">{faqs.map((faq, i) => <details name="faq" open={i === 0}><summary>{faq.q}<Plus size={21} aria-hidden="true" /></summary><p>{faq.a}</p></details>)}</div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="contact-image"><Image src={flowers} alt="A beautifully planted flower bed with red and pink blooms" width={1200} height={1200} format="webp" loading="lazy" /><div class="reveal"><div class="eyebrow">LET’S MAKE SOMETHING BEAUTIFUL</div><h2>A better yard<br />starts with<br />a <em>hello.</em></h2><p>Tell us what you have in mind.<br />We’ll take it from there.</p></div></div>
      <div class="contact-content reveal" style="--reveal-delay: 100ms">
        <span class="eyebrow">YOUR NEXT CHAPTER STARTS OUTSIDE</span><h2>Let’s talk about<br />your outdoor space.</h2><p>From regular lawn care to a fresh start for your landscape, we’d love to help. Call or text for your free estimate.</p>
        <a class="contact-phone" href="tel:+15743866078"><span><Phone size={27} stroke-width={1.5} aria-hidden="true" /></span><div><small>CALL OR TEXT OUR TEAM</small><strong>(574) 386-6078</strong></div><ArrowUpRight size={24} aria-hidden="true" /></a>
        <div class="contact-actions"><a class="button button-red" href="sms:+15743866078">TEXT US ABOUT YOUR PROJECT <ArrowUpRight size={17} aria-hidden="true" /></a><a class="contact-email" href="mailto:floreslandscaping098@gmail.com"><Mail size={18} aria-hidden="true" /> Prefer email? Let’s talk.</a></div>
        <div class="contact-note"><BadgeCheck size={18} aria-hidden="true" /> Free estimates. Friendly advice. No pressure.</div>
      </div>
    </section>
    <section class="service-area" aria-label="Our service area"><div class="container"><MapPin size={22} aria-hidden="true" /><span>YOUR LOCAL LANDSCAPING TEAM</span><p>South Bend <span>·</span> Mishawaka <span>·</span> Granger <span>·</span> Osceola</p></div></section>
  </main>
  <Footer />

  <dialog id="project-dialog" aria-labelledby="project-dialog-title">
    <div class="lightbox-shell">
      <button class="lightbox-close circle-button" aria-label="Close project photo"><X size={24} aria-hidden="true" /></button>
      <img id="project-dialog-image" src="" alt="" />
      <div class="lightbox-caption"><div><p id="project-dialog-category"></p><h2 id="project-dialog-title"></h2></div></div>
    </div>
  </dialog>

  <script>
    import '../scripts/home-motion';

    import '../scripts/project-comparisons';

    const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav [data-section]');
    const navObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) sectionLinks.forEach(link => link.classList.toggle('active', link.dataset.section === entry.target.id));
      });
    }, { rootMargin: '-15% 0px -60% 0px' });
    ['home', 'about', 'services', 'projects', 'contact'].forEach(id => { const el = document.getElementById(id); if (el) navObserver.observe(el); });
  </script>
</BaseLayout>

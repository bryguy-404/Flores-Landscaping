---
import rawContent from '../content/home.json';
import { readContent, resolvePhoto, safeLink, business, phoneHref, emailHref, serviceAreas } from '../lib/cms';
const content = readContent(rawContent);
import Image from '../components/CmsImage.astro';
import { ArrowRight, ArrowUpRight, ChevronLeft, ChevronRight, TreePine, Leaf, Sprout, House, Building, BadgeCheck, Phone, Mail, MapPin, Check, Shovel, Users, Plus, Pause, Play } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import ProjectComparison from '../components/ProjectComparison.astro';
import { homeComparisons } from '../data/work';
import PhotoViewer from '../components/PhotoViewer.astro';

import { serviceOfferings } from '../data/services';

const services = serviceOfferings;
const faqs = Object.values(content.faqs);
---
<BaseLayout title={content.seo.title} description={content.seo.description}>
  <div id="home"></div>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title" aria-roledescription="carousel" aria-label="Flores landscaping photos">
      <div class="hero-images" id="hero-images" aria-live="off">
        <Image class="hero-image hero-image-hedge is-active" src={resolvePhoto(content.hero.photo).src} alt={content.hero.photo.alt} widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="eager" fetchpriority="high"  position={content.hero.photo.position} mobilePosition={content.hero.photo.mobilePosition} />
        <Image class="hero-image" src={resolvePhoto(content.hero.photo2).src} alt={content.hero.photo2.alt} widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true"  position={content.hero.photo2.position} mobilePosition={content.hero.photo2.mobilePosition} />
        <Image class="hero-image" src={resolvePhoto(content.hero.photo3).src} alt={content.hero.photo3.alt} widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true"  position={content.hero.photo3.position} mobilePosition={content.hero.photo3.mobilePosition} />
        <Image class="hero-image" src={resolvePhoto(content.hero.photo4).src} alt={content.hero.photo4.alt} widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true"  position={content.hero.photo4.position} mobilePosition={content.hero.photo4.mobilePosition} />
      </div>
      <div class="hero-shade"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow"><TreePine size={43} stroke-width={1.3} aria-hidden="true" /><span>{content.hero.text}<br />{content.hero.text2}</span></div>
          <h1 id="hero-title">{content.hero.heading}<br />{content.hero.heading2} <span>{content.hero.text3}</span></h1>
          <p>{content.hero.paragraph}</p>
          <div class="hero-actions flex flex-wrap gap-4">
            <a class="button button-red" href={safeLink(content.hero.link)}>{content.hero.linkLabel} <ArrowUpRight size={18} aria-hidden="true" /></a>
            <a class="button button-outline" href={safeLink(content.hero.link2)}>{content.hero.linkLabel2}</a>
          </div>
        </div>
      </div>
      <button class="hero-arrow hero-prev" aria-label="Previous landscape photo"><ChevronLeft aria-hidden="true" /></button>
      <button class="hero-arrow hero-next" aria-label="Next landscape photo"><ChevronRight aria-hidden="true" /></button>
      <div class="container hero-bottom">
        <span class="hero-caption">{content.hero.text4}</span>
        <div class="hero-playback">
          <div class="hero-dots" role="group" aria-label="Choose landscape photo">
            {[0, 1, 2, 3].map(i => <button class:list={[{ 'is-active': i === 0 }]} aria-label={`Show landscape photo ${i + 1}`} aria-pressed={i === 0} data-slide={i}></button>)}
          </div>
          <button id="hero-autoplay" class="autoplay-toggle" aria-label="Pause hero slideshow" aria-controls="hero-images" data-carousel-label="hero slideshow" hidden><Pause class="pause-icon" size={14} aria-hidden="true" /><Play class="play-icon" size={14} aria-hidden="true" /></button>
        </div>
      </div>
    </section>

    <section class="property-services container" aria-label="Residential and commercial landscaping" data-reveal-group>
      <a class="property-card" href={safeLink(content.propertyServices.link)}>
        <div class="property-label"><House size={43} stroke-width={1.25} aria-hidden="true" /><h2>{content.propertyServices.heading}<br />{content.propertyServices.heading2}</h2><span>{content.propertyServices.text} <ArrowUpRight size={18} aria-hidden="true" /></span></div>
        <Image src={resolvePhoto(content.propertyServices.photo).src} alt={content.propertyServices.photo.alt} width={600} height={350} format="webp" loading="lazy"  position={content.propertyServices.photo.position} mobilePosition={content.propertyServices.photo.mobilePosition} />
      </a>
      <a class="property-card" href={safeLink(content.propertyServices.link2)}>
        <div class="property-label"><Building size={43} stroke-width={1.25} aria-hidden="true" /><h2>{content.propertyServices.heading3}<br />{content.propertyServices.heading4}</h2><span>{content.propertyServices.text2} <ArrowUpRight size={18} aria-hidden="true" /></span></div>
        <Image src={resolvePhoto(content.propertyServices.photo2).src} alt={content.propertyServices.photo2.alt} width={600} height={350} format="webp" loading="lazy"  position={content.propertyServices.photo2.position} mobilePosition={content.propertyServices.photo2.mobilePosition} />
      </a>
    </section>

    <section id="about" class="about-section section-pad">
      <div class="container about-grid">
        <div class="about-visual reveal">
          <div class="about-photo-main"><Image src={resolvePhoto(content.about.photo).src} alt={content.about.photo.alt} width={750} height={920} format="webp" loading="lazy"  position={content.about.photo.position} mobilePosition={content.about.photo.mobilePosition} /></div>
          <div class="about-photo-detail"><Image src={resolvePhoto(content.about.photo2).src} alt={content.about.photo2.alt} width={430} height={460} format="webp" loading="lazy"  position={content.about.photo2.position} mobilePosition={content.about.photo2.mobilePosition} /></div>
          <div class="experience-badge"><strong>{business.experienceYears}<span>+</span></strong><span>{content.about.text}<br />{content.about.text2}</span></div>
          <span class="image-footnote">{content.about.text3}</span>
        </div>
        <div class="about-copy reveal" style="--reveal-delay: 100ms">
          <div class="eyebrow"><Leaf size={19} aria-hidden="true" /> {content.about.eyebrow}</div>
          <h2>{content.about.heading}<br />{content.about.heading2} <em>{content.about.text4}</em></h2>
          <p class="lead">{content.about.paragraph}</p>
          <p>{content.about.paragraph2}</p>
          <div class="about-values">
            <div><span class="value-icon"><Sprout size={27} stroke-width={1.5} aria-hidden="true" /></span><div><h3>{content.about.heading3}</h3><p>{content.about.paragraph3}</p></div></div>
            <div><span class="value-icon"><Users size={27} stroke-width={1.5} aria-hidden="true" /></span><div><h3>{content.about.heading4}</h3><p>{content.about.paragraph4}</p></div></div>
          </div>
          <a class="text-link" href={safeLink(content.about.link)}>{content.about.linkLabel} <ArrowRight size={20} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="container trust-strip reveal"><span><BadgeCheck size={20} aria-hidden="true" /> {content.about.text5}</span><span><Users size={20} aria-hidden="true" /> {content.about.text6}</span><span><Check size={20} aria-hidden="true" /> {content.about.text7}</span></div>
    </section>

    <section id="services" class="services-section section-pad">
      <div class="container">
        <div class="section-heading reveal"><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> {content.services.eyebrow}</div><h2>{content.services.heading}<br />{content.services.heading2} <em>{content.services.text}</em></h2><p>{content.services.paragraph}</p></div>
        <div class="service-carousel reveal">
          <div class="service-track" id="service-track" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Landscaping services" aria-live="off">
            {services.map(({ icon: Icon, ...service }, i) => <article class="service-card">
              <div class="service-photo"><Image src={service.homePhoto.src} alt={service.homePhoto.alt} position={service.homePhoto.position} mobilePosition={service.homePhoto.mobilePosition} width={700} height={510} format="webp" loading="lazy"  /><span class="service-icon"><Icon size={30} stroke-width={1.5} aria-hidden="true" /></span><span class="service-number">0{i + 1}</span></div>
              <div class="service-content"><h3>{service.title}</h3><p>{service.summary}</p><a href={safeLink(service.link)} class="text-link" aria-label={`Explore ${service.title}`}>{content.services.linkLabel} <ArrowUpRight size={18} aria-hidden="true" /></a></div>
            </article>)}
          </div>
        </div>
        <div class="service-controls"><span>{content.services.text2}</span><div class="service-playback flex gap-2"><button id="services-autoplay" class="circle-button autoplay-toggle" aria-label="Pause services carousel" aria-controls="service-track" data-carousel-label="services carousel" hidden><Pause class="pause-icon" size={16} aria-hidden="true" /><Play class="play-icon" size={16} aria-hidden="true" /></button><button class="circle-button" id="service-prev" aria-label="Previous services" aria-controls="service-track"><ChevronLeft size={20} aria-hidden="true" /></button><button class="circle-button" id="service-next" aria-label="Next services" aria-controls="service-track"><ChevronRight size={20} aria-hidden="true" /></button></div></div>
      </div>
    </section>

    <section id="projects" class="projects-section section-pad" aria-labelledby="projects-title">
      <div class="container projects-heading reveal"><div><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> {content.projects.eyebrow}</div><h2 id="projects-title">{content.projects.heading}<br /><em>{content.projects.text}</em></h2></div><p>{content.projects.paragraph}</p></div>
      <div class="project-grid reveal" id="project-track" role="region" aria-label="Before-and-after projects" tabindex="0">
        {homeComparisons.map(comparison => <ProjectComparison {...comparison} />)}
      </div>
      <div class="project-navigation container" hidden>
        <span>{content.projects.text2} <span id="project-count" aria-live="polite" aria-atomic="true">01 / 03</span></span>
        <div class="flex gap-2"><button class="circle-button" id="project-prev" aria-label="Previous transformation" aria-controls="project-track"><ChevronLeft size={20} aria-hidden="true" /></button><button class="circle-button" id="project-next" aria-label="Next transformation" aria-controls="project-track"><ChevronRight size={20} aria-hidden="true" /></button></div>
      </div>
      <div class="container work-projects-link"><a class="text-link" href={safeLink(content.projects.link)}>{content.projects.linkLabel} <ArrowRight size={18} aria-hidden="true" /></a></div>
    </section>

    <section class="promise-band" aria-label="The Flores difference">
      <div class="container promise-grid" data-reveal-group>
        <div><TreePine size={39} stroke-width={1.3} aria-hidden="true" /><strong>{business.experienceYears}<span>+</span></strong><span>{content.promiseBand.text}</span></div>
        <div><Users size={39} stroke-width={1.3} aria-hidden="true" /><strong>{content.promiseBand.text2}</strong><span>{content.promiseBand.text3}</span></div>
        <div><BadgeCheck size={39} stroke-width={1.3} aria-hidden="true" /><strong>{content.promiseBand.text4}</strong><span>{content.promiseBand.text5}</span></div>
        <div><Shovel size={39} stroke-width={1.3} aria-hidden="true" /><strong>{content.promiseBand.text6}</strong><span>{content.promiseBand.text7}</span></div>
      </div>
    </section>

    <GoogleReviews />

    <section id="faq" class="faq-section section-pad">
      <div class="container faq-grid">
        <div class="reveal"><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> {content.faq.eyebrow}</div><h2>{content.faq.heading}<br /><em>{content.faq.text}</em></h2><p>{content.faq.paragraph}</p><a class="text-link" href={phoneHref}>{content.faq.linkLabel} <ArrowUpRight size={20} aria-hidden="true" /></a></div>
        <div class="faq-list reveal" style="--reveal-delay: 100ms">{faqs.map((faq, i) => <details name="faq" open={i === 0}><summary>{faq.q}<Plus size={21} aria-hidden="true" /></summary><p>{faq.a}</p></details>)}</div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="contact-image"><Image src={resolvePhoto(content.contact.photo).src} alt={content.contact.photo.alt} width={1200} height={1200} format="webp" loading="lazy"  position={content.contact.photo.position} mobilePosition={content.contact.photo.mobilePosition} /><div class="reveal"><div class="eyebrow">{content.contact.eyebrow}</div><h2>{content.contact.heading}<br />{content.contact.heading2}<br />{content.contact.heading3} <em>{content.contact.text}</em></h2><p>{content.contact.paragraph}<br />{content.contact.paragraph2}</p></div></div>
      <div class="contact-content reveal" style="--reveal-delay: 100ms">
        <span class="eyebrow">{content.contact.eyebrow2}</span><h2>{content.contact.heading4}<br />{content.contact.heading5}</h2><p>{content.contact.paragraph3}</p>
        <a class="contact-phone" href={phoneHref}><span><Phone size={27} stroke-width={1.5} aria-hidden="true" /></span><div><small>{content.contact.text2}</small><strong>{business.primaryPhone}</strong></div><ArrowUpRight size={24} aria-hidden="true" /></a>
        <div class="contact-actions"><a class="button button-red" href={safeLink(content.contact.link)}>{content.contact.linkLabel} <ArrowUpRight size={17} aria-hidden="true" /></a><a class="contact-email" href={emailHref}><Mail size={18} aria-hidden="true" /> {content.contact.linkLabel2}</a></div>
        <div class="contact-note"><BadgeCheck size={18} aria-hidden="true" /> {content.contact.text3}</div>
      </div>
    </section>
    <section class="service-area" aria-label="Our service area"><div class="container"><MapPin size={22} aria-hidden="true" /><span>{content.serviceArea.text}</span><p>{serviceAreas.map((city, i) => <>{i > 0 && <> <span>·</span> </>}{city}</>)}</p></div></section>
  </main>
  <Footer />

  <PhotoViewer />

  <script>
    import '../scripts/home-motion';

    import '../scripts/project-comparisons';

    const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav [data-section]');
    const navObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) sectionLinks.forEach(link => link.classList.toggle('active', link.dataset.section === entry.target.id));
      });
    }, { rootMargin: '-15% 0px -60% 0px' });
    ['home', 'about', 'services', 'projects', 'contact'].forEach(id => { const el = document.getElementById(id); if (el) navObserver.observe(el); });
  </script>
</BaseLayout>

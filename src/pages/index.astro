---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight, ChevronLeft, ChevronRight, TreePine, Leaf, Sprout, House, Building, BadgeCheck, Phone, Mail, MapPin, Check, Flower2, Snowflake, Scissors, Shovel, Users, X, Plus } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import hero from '../assets/lawn-stripes.jpg';
import hedgeHero from '../assets/hedge-hero.jpg';
import beds from '../assets/landscape-beds.jpg';
import flowers from '../assets/flower-garden.jpg';
import lawn from '../assets/lawn-care.jpg';
import mulch from '../assets/mulch.jpg';
import sod from '../assets/sod-installation.jpg';
import snow from '../assets/snow-removal.jpg';
import trimming from '../assets/trimming.jpg';
import garden from '../assets/garden-bed.jpg';
import edging from '../assets/stone-edging.jpg';
import backyard from '../assets/backyard.jpg';

const services = [
  { title: 'Lawn Care', description: 'Fresh cuts, crisp edges, and a lawn you’ll love coming home to.', image: lawn, alt: 'Freshly mowed lawn with even stripes', icon: Leaf },
  { title: 'Landscaping', description: 'Thoughtful landscapes that bring out the best in your property.', image: beds, alt: 'Curved planting beds with shrubs and decorative stone', icon: TreePine },
  { title: 'Mulch & Planting', description: 'A fresh layer of mulch and the right plants make all the difference.', image: flowers, alt: 'Colorful flowering plants in a landscaped garden bed', icon: Flower2 },
  { title: 'Sod Installation', description: 'Give your outdoor space a fresh start with a new lawn.', image: sod, alt: 'Newly installed sod alongside a residential walkway', icon: Sprout },
  { title: 'Spring & Fall Cleanup', description: 'A little seasonal care goes a long way toward a beautiful yard.', image: garden, alt: 'Freshly maintained planting bed in a green lawn', icon: Shovel },
  { title: 'Trimming', description: 'Neat hedges and carefully shaped shrubs, season after season.', image: trimming, alt: 'Hedge trimming with a powered trimmer', icon: Scissors },
  { title: 'Snow Plowing', description: 'Keep your property accessible when winter weather rolls in.', image: snow, alt: 'Snow removal equipment working on a snowy property', icon: Snowflake },
];
const projects = [
  { image: beds, title: 'A welcoming first impression', category: 'Landscaping', alt: 'Neatly shaped shrubs, stone beds and lawn in front of a home' },
  { image: mulch, title: 'Beautiful down to the details', category: 'Mulch & garden beds', alt: 'Red mulch and white stone borders surrounding mature trees' },
  { image: lawn, title: 'A greener everyday', category: 'Lawn care', alt: 'Fresh parallel mowing stripes across a green residential lawn' },
  { image: edging, title: 'Room for something beautiful', category: 'Landscape maintenance', alt: 'Stone border curving around trimmed shrubs and a lawn' },
  { image: flowers, title: 'Color around every corner', category: 'Planting', alt: 'Red and pink flowers beside a driveway and evergreen shrubs' },
  { image: backyard, title: 'Your own backyard retreat', category: 'Garden beds', alt: 'Maintained stone garden bed beside a residential deck' },
];
const faqs = [
  { q: 'What areas do you serve?', a: 'We serve residential and commercial properties in South Bend, Mishawaka, Granger, and Osceola. If you’re nearby and aren’t sure whether we cover your area, give us a call or send us a text.' },
  { q: 'Do you offer free estimates?', a: 'Yes! We offer free estimates for lawn care and landscaping projects. Call or text us to tell us about your property and schedule a consultation.' },
  { q: 'Are you licensed and insured?', a: 'Yes, Flores Landscaping is fully licensed and insured. We take care to protect your property while delivering professional, reliable service.' },
  { q: 'Can you help throughout the year?', a: 'Yes. Our services include lawn care, landscape maintenance, spring and fall cleanups, and winter snow plowing. Contact us to discuss what your property needs this season.' },
];
---
<BaseLayout>
  <div id="home"></div>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title" aria-roledescription="carousel" aria-label="Flores landscaping photos">
      <div class="hero-images">
        <Image class="hero-image hero-image-hedge is-active" src={hedgeHero} alt="A landscaper carefully trimming a hedge" widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="eager" fetchpriority="high" />
        <Image class="hero-image" src={hero} alt="A freshly mowed Flores Landscaping lawn framed by mature trees" widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true" />
        <Image class="hero-image" src={beds} alt="Professionally maintained shrubs and landscape beds" widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true" />
        <Image class="hero-image" src={flowers} alt="A colorful flower garden beside a home" widths={[640, 960, 1440, 1920]} sizes="100vw" width={1920} format="webp" loading="lazy" aria-hidden="true" />
      </div>
      <div class="hero-shade"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow"><TreePine size={43} stroke-width={1.3} aria-hidden="true" /><span>Rooted in family.<br />Growing beautiful spaces.</span></div>
          <h1 id="hero-title">Beautiful landscapes.<br />Made for <span>living.</span></h1>
          <p>A little more green. A lot more care. Your local Flores team brings out the best in your outdoor space.</p>
          <div class="hero-actions flex flex-wrap gap-4">
            <a class="button button-red" href="#contact">GET A FREE ESTIMATE <ArrowUpRight size={18} aria-hidden="true" /></a>
            <a class="button button-outline" href="#projects">EXPLORE OUR WORK</a>
          </div>
        </div>
      </div>
      <button class="hero-arrow hero-prev" aria-label="Previous landscape photo"><ChevronLeft aria-hidden="true" /></button>
      <button class="hero-arrow hero-next" aria-label="Next landscape photo"><ChevronRight aria-hidden="true" /></button>
      <div class="container hero-bottom">
        <span class="hero-caption">LOCAL ROOTS. LASTING BEAUTY.</span>
        <div class="hero-dots" role="group" aria-label="Choose landscape photo">
          {[0, 1, 2, 3].map(i => <button class:list={[{ 'is-active': i === 0 }]} aria-label={`Show landscape photo ${i + 1}`} aria-pressed={i === 0} data-slide={i}></button>)}
        </div>
      </div>
    </section>

    <section class="property-services container" aria-label="Residential and commercial landscaping">
      <a class="property-card" href="#contact">
        <div class="property-label"><House size={43} stroke-width={1.25} aria-hidden="true" /><h2>Residential<br />Services</h2><span>GET IN TOUCH <ArrowUpRight size={18} aria-hidden="true" /></span></div>
        <Image src={beds} alt="Well-maintained landscaping in front of a home" width={600} height={350} format="webp" loading="lazy" />
      </a>
      <a class="property-card" href="#contact">
        <div class="property-label"><Building size={43} stroke-width={1.25} aria-hidden="true" /><h2>Commercial<br />Services</h2><span>GET IN TOUCH <ArrowUpRight size={18} aria-hidden="true" /></span></div>
        <Image src={hero} alt="Wide, neatly maintained green lawn" width={600} height={350} format="webp" loading="lazy" />
      </a>
    </section>

    <section id="about" class="about-section section-pad">
      <div class="container about-grid">
        <div class="about-visual reveal">
          <div class="about-photo-main"><Image src={beds} alt="Flores landscaping with curved stone beds and carefully trimmed shrubs" width={750} height={920} format="webp" loading="lazy" /></div>
          <div class="about-photo-detail"><Image src={mulch} alt="Red mulch and decorative white rock around trees" width={430} height={460} format="webp" loading="lazy" /></div>
          <div class="experience-badge"><strong>20<span>+</span></strong><span>YEARS OF<br />HANDS-ON CARE</span></div>
          <span class="image-footnote">A little pride in every detail.</span>
        </div>
        <div class="about-copy reveal">
          <div class="eyebrow"><Leaf size={19} aria-hidden="true" /> ABOUT FLORES LANDSCAPING</div>
          <h2>Your yard.<br />Our family’s <em>pride.</em></h2>
          <p class="lead">Good landscaping starts with people who care.</p>
          <p>We’re a family-owned team with more than 20 years of experience caring for outdoor spaces around South Bend. From a freshly cut lawn to a whole new landscape, we bring a personal touch to every job.</p>
          <div class="about-values">
            <div><span class="value-icon"><Sprout size={27} stroke-width={1.5} aria-hidden="true" /></span><div><h3>Care that goes beyond the cut</h3><p>Thoughtful work, from the first visit to the finishing touches.</p></div></div>
            <div><span class="value-icon"><Users size={27} stroke-width={1.5} aria-hidden="true" /></span><div><h3>Your neighbors, your landscaping team</h3><p>Local experience. Friendly faces. Pride in our community.</p></div></div>
          </div>
          <a class="text-link" href="#contact">LET’S TALK ABOUT YOUR PROPERTY <ArrowRight size={20} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="container trust-strip reveal"><span><BadgeCheck size={20} aria-hidden="true" /> LICENSED & INSURED</span><span><Users size={20} aria-hidden="true" /> FAMILY OWNED & OPERATED</span><span><Check size={20} aria-hidden="true" /> FREE, NO-OBLIGATION ESTIMATES</span></div>
    </section>

    <section id="services" class="services-section section-pad">
      <div class="container">
        <div class="section-heading reveal"><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> A LITTLE CARE. A BIG DIFFERENCE.</div><h2>Good things grow<br />with the right <em>care.</em></h2><p>Everything your outdoor space needs, from the ground up.</p></div>
        <div class="service-carousel">
          <div class="service-track" id="service-track" tabindex="0" role="region" aria-label="Landscaping services; scroll to see more">
            {services.map(({ icon: Icon, ...service }, i) => <article class="service-card">
              <div class="service-photo"><Image src={service.image} alt={service.alt} width={700} height={510} format="webp" loading="lazy" /><span class="service-icon"><Icon size={30} stroke-width={1.5} aria-hidden="true" /></span><span class="service-number">0{i + 1}</span></div>
              <div class="service-content"><h3>{service.title}</h3><p>{service.description}</p><a href="#contact" class="text-link">LET’S GET STARTED <ArrowUpRight size={18} aria-hidden="true" /></a></div>
            </article>)}
          </div>
        </div>
        <div class="service-controls"><span>Lawn care to seasonal cleanups. We’ve got you covered.</span><div class="flex gap-2"><button class="circle-button" id="service-prev" aria-label="Previous services" aria-controls="service-track"><ChevronLeft size={20} aria-hidden="true" /></button><button class="circle-button" id="service-next" aria-label="Next services" aria-controls="service-track"><ChevronRight size={20} aria-hidden="true" /></button></div></div>
      </div>
    </section>

    <section id="projects" class="projects-section section-pad">
      <div class="container projects-heading reveal"><div><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> A FEW OF OUR FAVORITES</div><h2>Real yards.<br /><em>Real transformations.</em></h2></div><p>There’s no better introduction than our work.<br />Take a look around some spaces we’ve cared for.</p></div>
      <div class="project-grid">
        {projects.map((project, i) => <button class="project-card" data-project={i} aria-label={`View project: ${project.title}`}>
          <Image src={project.image} alt={project.alt} width={1000} height={800} format="webp" loading="lazy" />
          <span class="project-overlay"><span><small>{project.category}</small><strong>{project.title}</strong></span><span class="project-open"><Plus size={25} aria-hidden="true" /></span></span>
        </button>)}
      </div>
    </section>

    <section class="promise-band" aria-label="The Flores difference">
      <div class="container promise-grid">
        <div><TreePine size={39} stroke-width={1.3} aria-hidden="true" /><strong>20<span>+</span></strong><span>Years of experience</span></div>
        <div><Users size={39} stroke-width={1.3} aria-hidden="true" /><strong>Family</strong><span>Owned & operated</span></div>
        <div><BadgeCheck size={39} stroke-width={1.3} aria-hidden="true" /><strong>Local</strong><span>Care you can count on</span></div>
        <div><Shovel size={39} stroke-width={1.3} aria-hidden="true" /><strong>Every season</strong><span>Here for your outdoor space</span></div>
      </div>
    </section>

    <section id="faq" class="faq-section section-pad">
      <div class="container faq-grid">
        <div class="reveal"><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> GOOD TO KNOW</div><h2>A few questions,<br /><em>before we grow.</em></h2><p>Getting started should feel easy. Here are a few things you might be wondering.</p><a class="text-link" href="tel:+15743866078">WE’RE ALWAYS HAPPY TO HELP <ArrowUpRight size={20} aria-hidden="true" /></a></div>
        <div class="faq-list reveal">{faqs.map((faq, i) => <details name="faq" open={i === 0}><summary>{faq.q}<Plus size={21} aria-hidden="true" /></summary><p>{faq.a}</p></details>)}</div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="contact-image"><Image src={flowers} alt="A beautifully planted flower bed with red and pink blooms" width={1200} height={1200} format="webp" loading="lazy" /><div><div class="eyebrow">LET’S MAKE SOMETHING BEAUTIFUL</div><h2>A better yard<br />starts with<br />a <em>hello.</em></h2><p>Tell us what you have in mind.<br />We’ll take it from there.</p></div></div>
      <div class="contact-content">
        <span class="eyebrow">YOUR NEXT CHAPTER STARTS OUTSIDE</span><h2>Let’s talk about<br />your outdoor space.</h2><p>From regular lawn care to a fresh start for your landscape, we’d love to help. Call or text for your free estimate.</p>
        <a class="contact-phone" href="tel:+15743866078"><span><Phone size={27} stroke-width={1.5} aria-hidden="true" /></span><div><small>CALL OR TEXT OUR TEAM</small><strong>(574) 386-6078</strong></div><ArrowUpRight size={24} aria-hidden="true" /></a>
        <div class="contact-actions"><a class="button button-red" href="sms:+15743866078">TEXT US ABOUT YOUR PROJECT <ArrowUpRight size={17} aria-hidden="true" /></a><a class="contact-email" href="mailto:floreslandscaping098@gmail.com"><Mail size={18} aria-hidden="true" /> Prefer email? Let’s talk.</a></div>
        <div class="contact-note"><BadgeCheck size={18} aria-hidden="true" /> Free estimates. Friendly advice. No pressure.</div>
      </div>
    </section>
    <section class="service-area" aria-label="Our service area"><div class="container"><MapPin size={22} aria-hidden="true" /><span>YOUR LOCAL LANDSCAPING TEAM</span><p>South Bend <span>·</span> Mishawaka <span>·</span> Granger <span>·</span> Osceola</p></div></section>
  </main>
  <Footer />

  <dialog id="project-dialog" aria-labelledby="project-dialog-title">
    <div class="lightbox-shell">
      <button class="lightbox-close circle-button" aria-label="Close project photo"><X size={24} aria-hidden="true" /></button>
      <img id="project-dialog-image" src="" alt="" />
      <div class="lightbox-caption"><div><p id="project-dialog-category"></p><h2 id="project-dialog-title"></h2></div><div class="flex gap-2"><button class="circle-button" id="project-prev" aria-label="Previous project"><ChevronLeft aria-hidden="true" /></button><button class="circle-button" id="project-next" aria-label="Next project"><ChevronRight aria-hidden="true" /></button></div></div>
    </div>
  </dialog>

  <script>
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const revealElements = document.querySelectorAll<HTMLElement>('.reveal');
    if (!reducedMotion.matches && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } });
      }, { threshold: 0.12 });
      revealElements.forEach(el => { el.classList.add('will-reveal'); observer.observe(el); });
    }

    const heroImages = document.querySelectorAll<HTMLImageElement>('.hero-image');
    const heroDots = document.querySelectorAll<HTMLButtonElement>('[data-slide]');
    let currentSlide = 0;
    function showSlide(index: number) {
      currentSlide = (index + heroImages.length) % heroImages.length;
      heroImages.forEach((img, i) => { img.classList.toggle('is-active', i === currentSlide); img.setAttribute('aria-hidden', String(i !== currentSlide)); });
      heroDots.forEach((dot, i) => { dot.classList.toggle('is-active', i === currentSlide); dot.setAttribute('aria-pressed', String(i === currentSlide)); });
    }
    heroDots.forEach(dot => dot.addEventListener('click', () => showSlide(Number(dot.dataset.slide))));
    document.querySelector('.hero-prev')?.addEventListener('click', () => showSlide(currentSlide - 1));
    document.querySelector('.hero-next')?.addEventListener('click', () => showSlide(currentSlide + 1));

    const serviceTrack = document.querySelector<HTMLElement>('#service-track');
    const previousServices = document.querySelector<HTMLButtonElement>('#service-prev');
    const nextServices = document.querySelector<HTMLButtonElement>('#service-next');
    function updateServiceButtons() {
      if (!serviceTrack || !previousServices || !nextServices) return;
      previousServices.disabled = serviceTrack.scrollLeft < 5;
      nextServices.disabled = serviceTrack.scrollLeft >= serviceTrack.scrollWidth - serviceTrack.clientWidth - 5;
    }
    function moveServices(direction: number) {
      if (!serviceTrack) return;
      const card = serviceTrack.querySelector<HTMLElement>('.service-card');
      serviceTrack.scrollBy({ left: direction * ((card?.offsetWidth ?? 350) + 26), behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    }
    previousServices?.addEventListener('click', () => moveServices(-1));
    nextServices?.addEventListener('click', () => moveServices(1));
    serviceTrack?.addEventListener('scroll', updateServiceButtons, { passive: true });
    if (serviceTrack) new ResizeObserver(updateServiceButtons).observe(serviceTrack);
    updateServiceButtons();

    const projectCards = document.querySelectorAll<HTMLButtonElement>('[data-project]');
    const dialog = document.querySelector<HTMLDialogElement>('#project-dialog');
    let currentProject = 0;
    function updateProject(index: number) {
      currentProject = (index + projectCards.length) % projectCards.length;
      const card = projectCards[currentProject];
      const source = card.querySelector('img');
      const target = document.querySelector<HTMLImageElement>('#project-dialog-image');
      if (!target || !source) return;
      target.src = source.currentSrc || source.src;
      target.alt = source.alt;
      document.querySelector('#project-dialog-title')!.textContent = card.querySelector('strong')!.textContent;
      document.querySelector('#project-dialog-category')!.textContent = card.querySelector('small')!.textContent;
    }
    projectCards.forEach((card, i) => card.addEventListener('click', () => {
      updateProject(i); dialog?.showModal(); document.body.classList.add('dialog-open');
    }));
    document.querySelector('.lightbox-close')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('close', () => document.body.classList.remove('dialog-open'));
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    document.querySelector('#project-prev')?.addEventListener('click', () => updateProject(currentProject - 1));
    document.querySelector('#project-next')?.addEventListener('click', () => updateProject(currentProject + 1));
    dialog?.addEventListener('keydown', event => {
      if (event.key === 'ArrowRight') { event.preventDefault(); updateProject(currentProject + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); updateProject(currentProject - 1); }
    });

    const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a');
    const navObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) sectionLinks.forEach(link => link.classList.toggle('active', link.hash === `#${entry.target.id}`));
      });
    }, { rootMargin: '-15% 0px -60% 0px' });
    ['home', 'about', 'services', 'projects', 'contact'].forEach(id => { const el = document.getElementById(id); if (el) navObserver.observe(el); });
  </script>
</BaseLayout>

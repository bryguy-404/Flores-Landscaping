---
import { Leaf, ArrowUpRight, ChevronLeft, ChevronRight } from '@lucide/astro';
import { googleReviewsUrl } from '../lib/google-reviews';
import '../styles/reviews.css';
---
<section id="reviews" class="reviews-section section-pad" aria-labelledby="reviews-title" data-review-state="fallback">
  <div class="container">
    <div class="reviews-heading">
      <div><div class="eyebrow"><Leaf size={19} aria-hidden="true" /> WORDS FROM OUR COMMUNITY</div><h2 id="reviews-title">Good work.<br /><em>Happy neighbors.</em></h2></div>
      <div class="reviews-heading-copy"><p>See what customers have shared about their experience with Flores Landscaping.</p><a class="text-link" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">READ OUR GOOGLE REVIEWS <ArrowUpRight size={18} aria-hidden="true" /></a></div>
    </div>
    <p class="reviews-fallback" data-review-fallback>Visit our Google profile to read customer reviews and share your experience.</p>
    <div data-review-content hidden>
      <div class="reviews-track" id="reviews-track" role="region" aria-label="Customer reviews" tabindex="0"></div>
      <div class="reviews-bottom">
        <div class="reviews-attribution">
          <img class="reviews-google-wordmark" src="/google-wordmark.png" alt="Google" width="92" height="30" loading="lazy" />
          <p>Five-star written reviews from Google’s selection, newest first. <span class="reviews-maps-credit" translate="no">Google Maps</span></p>
          <div data-review-providers></div>
        </div>
        <div class="reviews-controls" data-review-controls hidden>
          <button type="button" class="circle-button" data-review-prev aria-label="Previous reviews" aria-controls="reviews-track"><ChevronLeft size={20} aria-hidden="true" /></button>
          <button type="button" class="circle-button" data-review-next aria-label="Next reviews" aria-controls="reviews-track"><ChevronRight size={20} aria-hidden="true" /></button>
        </div>
      </div>
    </div>
    <template data-review-template>
      <article class="review-card">
        <div class="review-stars" role="img" aria-label="5 out of 5 stars"><span aria-hidden="true">★★★★★</span></div>
        <blockquote><p data-review-text dir="auto"></p></blockquote>
        <button type="button" class="review-expand" data-review-expand aria-expanded="false" hidden>Read more</button>
        <div class="review-person">
          <img data-review-avatar width="44" height="44" alt="" loading="lazy" referrerpolicy="no-referrer" hidden />
          <div><a data-review-author target="_blank" rel="noopener noreferrer"></a><time data-review-date hidden></time></div>
        </div>
        <a class="review-source" data-review-source target="_blank" rel="noopener noreferrer">Read on Google Maps <span aria-hidden="true">↗</span></a>
      </article>
    </template>
  </div>
</section>
<script>
  import '../scripts/google-reviews';
</script>

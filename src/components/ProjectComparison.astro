---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ChevronLeft, ChevronRight, Expand } from '@lucide/astro';
interface Props {
  id: string; title: string; category: string;
  before: ImageMetadata; after: ImageMetadata;
  beforeAlt: string; afterAlt: string;
  variant?: 'home' | 'work';
  beforePosition?: string; afterPosition?: string;
}
const { id, title, category, before, after, beforeAlt, afterAlt, variant = 'home', beforePosition = '50% 50%', afterPosition = '50% 50%' } = Astro.props;
const [beforeFull, afterFull] = await Promise.all([before, after].map(src => getImage({ src, width: Math.min(src.width, Math.round(1600 * src.width / Math.max(src.width, src.height))), format: 'webp', quality: 80 })));
---
<article class:list={['project-card', 'comparison-card', { 'work-pair': variant === 'work' }]} data-comparison aria-labelledby={`${id}-title`}>
  <div class="comparison-stage" id={`${id}-images`}>
    <div class="comparison-layer comparison-after"><Image class="comparison-photo" style={`object-position: ${afterPosition}`} src={after} width={1080} alt={afterAlt} widths={[480, 800, 1080]} sizes="(max-width: 767px) 90vw, (max-width: 1023px) 60vw, 33vw" format="webp" loading="lazy" /></div>
    <div class="comparison-layer comparison-before"><Image class="comparison-photo" style={`object-position: ${beforePosition}`} src={before} width={1080} alt={beforeAlt} widths={[480, 800, 1080]} sizes="(max-width: 767px) 90vw, (max-width: 1023px) 60vw, 33vw" format="webp" loading="lazy" /></div>
    <div class="comparison-labels" aria-hidden="true"><span>BEFORE</span><span>AFTER</span></div>
    <div class="comparison-divider" aria-hidden="true"><span><ChevronLeft size={16} /><ChevronRight size={16} /></span></div>
    <input class="comparison-range" type="range" min="0" max="100" value="50" aria-label={`Compare before and after: ${title}`} aria-valuetext="Before 50%, after 50%" aria-controls={`${id}-images`} hidden />
    <div class="project-overlay">
      {variant === 'home' && <div><small>{category}</small><h3 id={`${id}-title`}>{title}</h3></div>}
      <a class="project-open" href={afterFull.src} data-photo-open data-photo-title={title} data-photo-alt={afterAlt} data-photo-before={beforeFull.src} data-photo-before-alt={beforeAlt} aria-label={`Enlarge before and after: ${title}`}><Expand size={19} aria-hidden="true" /></a>
    </div>
  </div>
  <div class="comparison-toolbar" hidden><span class="comparison-hint">Drag to see the difference</span><div class="comparison-toggle" role="group" aria-label={`View ${title}`}><button type="button" data-comparison-view="before" aria-pressed="false" aria-controls={`${id}-images`}>Before</button><button type="button" data-comparison-view="after" aria-pressed="false" aria-controls={`${id}-images`}>After</button></div></div>
  {variant === 'work' && <div class="work-pair-caption"><span>{category}</span><h3 id={`${id}-title`}>{title}</h3><p>Explore the before. Enjoy the after.</p></div>}
</article>

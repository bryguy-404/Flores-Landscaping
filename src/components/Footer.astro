---
import { Image } from 'astro:assets';
import { Phone, Mail, MapPin, ArrowUpRight } from '@lucide/astro';
import logo from '../assets/flores-logo.png';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="#home" aria-label="Flores Landscaping home"><Image src={logo} alt="Flores Landscaping" width={300} height={200} format="webp" loading="lazy" /></a>
      <p>Family owned. Locally rooted.<br />Taking pride in every property.</p>
    </div>
    <div>
      <h3>Explore</h3>
      <ul>
        <li><a href="#about">About Flores</a></li>
        <li><a href="#services">Our services</a></li>
        <li><a href="#projects">Our recent work</a></li>
        <li><a href="#faq">Common questions</a></li>
      </ul>
    </div>
    <div>
      <h3>Our services</h3>
      <ul>
        <li><a href="#services">Lawn care & landscaping</a></li>
        <li><a href="#services">Mulch & planting</a></li>
        <li><a href="#services">Trimming & seasonal cleanup</a></li>
        <li><a href="#services">Sod & snow plowing</a></li>
      </ul>
    </div>
    <div class="footer-contact">
      <h3>Let’s talk about your yard</h3>
      <a href="tel:+15743866078"><Phone size={18} aria-hidden="true" /> (574) 386-6078</a>
      <a href="tel:+15744720183"><Phone size={18} aria-hidden="true" /> (574) 472-0183</a>
      <a href="mailto:floreslandscaping098@gmail.com"><Mail size={18} aria-hidden="true" /> floreslandscaping098@gmail.com</a>
      <span><MapPin size={18} aria-hidden="true" /> South Bend, Indiana & nearby communities</span>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Flores Landscaping LLC. All rights reserved.</span>
    <a href="#home">Back to top <ArrowUpRight size={16} aria-hidden="true" /></a>
  </div>
</footer>
